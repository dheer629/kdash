[1;4mWHEN TO USE[0m  [38;5;243metcd data is lost or corrupted, or the cluster must go back to a known state[39m
  [1m[38;5;196m![0m [1mA restore rolls the WHOLE cluster back to the snapshot time: everything created or changed after it is lost.[0m
  [1m[38;5;196m![0m [1mRestoring onto NEW hosts needs the ORIGINAL server token (it decrypts the bootstrap data in the snapshot).[0m
  [1m[38;5;196m![0m [1mSnapshots contain the cluster CA keys and all Secrets: copy and store them like secrets.[0m

[1mSNAPSHOTS[0m
  [38;5;243munknown (unavailable) - list them on a server: sudo rke2 etcd-snapshot ls[39m

[1;4mA. RESTORE ONTO THE EXISTING SERVERS[0m  [38;5;243mservers: dev[39m

  [1mSTEP 0[0m  prepare (nothing changes yet)
      [38;5;29mread  [39m [38;5;63m[on dev][39m sudo rke2 etcd-snapshot ls  [38;5;243m# confirm the snapshot is on this node[39m
      [38;5;29mread  [39m [38;5;63m[on dev][39m sudo cat /var/lib/rancher/rke2/server/token  [38;5;243m# save the server token in your secret store first - needed for any restore onto new hosts[39m
      [38;5;29mread  [39m kdash --report  [38;5;243m# evidence of the current state before you change it[39m

  [1mSTEP 1[0m  stop rke2-server on every server
      [1m[38;5;163mCHANGE[0m [38;5;63m[on dev][39m sudo systemctl stop rke2-server  [38;5;243m# all servers must be down before the reset[39m

  [1mSTEP 2[0m  reset the cluster from the snapshot (on dev only)
      [1m[38;5;163mCHANGE[0m [38;5;63m[on dev][39m sudo rke2 server --cluster-reset --cluster-reset-restore-path=/var/lib/rancher/rke2/server/db/snapshots/<SNAPSHOT-NAME>  [38;5;243m# wait for: Managed etcd c›
[39m      [38;5;243mnote  [39m [38;5;243mif config.yaml has etcd-s3 settings and you restore this LOCAL file, add --etcd-s3=false[39m

  [1mSTEP 3[0m  start rke2-server on dev
      [1m[38;5;163mCHANGE[0m [38;5;63m[on dev][39m sudo systemctl start rke2-server  [38;5;243m# the reset flag file is removed on this normal start[39m
      [38;5;29mread  [39m kubectl --context kdash-local get nodes -o wide  [38;5;243m# wait until dev is Ready[39m

  [1mSTEP 4[0m  on every OTHER server: back up and delete the old etcd data
      [1m[38;5;163mCHANGE[0m [38;5;63m[on the other servers (none found)][39m sudo mv /var/lib/rancher/rke2/server/db /var/lib/rancher/rke2/server/db.bak-$(date +%Y%m%d%H%M%S)  [38;5;243m# RKE2 asks to back u›

[39m  [1mSTEP 5[0m  start rke2-server on the other servers, one at a time
      [1m[38;5;163mCHANGE[0m [38;5;63m[on the other servers (none found)][39m sudo systemctl start rke2-server  [38;5;243m# they rejoin the restored cluster; wait for Ready before the next[39m

  [1mSTEP 6[0m  verify
      [38;5;29mread  [39m kubectl --context kdash-local get nodes -o wide  [38;5;243m# all servers and agents Ready[39m
      [38;5;29mread  [39m kubectl --context kdash-local get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded  [38;5;243m# what has not come back yet[39m
      [38;5;29mread  [39m kdash --doctor && kdash --certs  [38;5;243m# API, access and certificates[39m
      [38;5;243mnote  [39m [38;5;243mnodes are restored from the snapshot too: delete nodes that no longer exist (kubectl --context kdash-local delete node NAME) and re-run workloads changed af›

