[1;4mWHEN TO USE[0m  [90mRKE2 certificates (API server, kubelet, supervisor, etcd) are close to expiry - see key C / kdash --certs[39m
  [1m[31m![0m [1mRKE2 renews certificates with under 120 days left only when the service starts; a node that never restarts expires silently.[0m
  [1m[31m![0m [1mThis renews leaf certificates. It does not rotate the CA (that is rke2 certificate rotate-ca - a separate, planned procedure).[0m

  [1mSTEP 1[0m  check, on each server
      [32mread  [39m [36m[on dev][39m sudo rke2 certificate check --output table

  [1mSTEP 2[0m  rotate on ONE server at a time
      [1m[33mCHANGE[0m [36m[on dev][39m sudo systemctl stop rke2-server
      [1m[33mCHANGE[0m [36m[on dev][39m sudo rke2 certificate rotate  [90m# add --service NAME to rotate only some (e.g. --service api-server)[39m
      [1m[33mCHANGE[0m [36m[on dev][39m sudo systemctl start rke2-server
      [32mread  [39m kubectl --context vcluster-docker_dev get nodes  [90m# the server is Ready again before you continue[39m

  [1mSTEP 3[0m  agents
      [1m[33mCHANGE[0m [36m[on each agent][39m sudo systemctl restart rke2-agent  [90m# renews the agent's certificates (under 120 days left)[39m

  [1mSTEP 4[0m  verify
      [32mread  [39m kdash --certs  [90m# nothing left in WARNING / CRITICAL[39m
      [90mnote  [39m [90mkubeconfig files that embed a client certificate (e.g. rke2.yaml) may need to be copied again after a rotation[39m





















