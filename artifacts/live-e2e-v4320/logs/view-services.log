NEXT COMMANDS  -  read = only reads, CHANGE = modifies the cluster or a node (printed only)

  #1  CRITICAL  missing-backend  selector app=does-not-exist matches no pod in this scope
      read   kubectl --context vcluster-docker_dev -n kdash-e2e get service missing-backend -o jsonpath='{.spec.selector}{"\n"}'  # what the Service selects
      read   kubectl --context vcluster-docker_dev -n kdash-e2e get pods --show-labels  # labels the pods really have
      CHANGE kubectl --context vcluster-docker_dev -n kdash-e2e edit service missing-backend  # make spec.selector match the pod labels (or fix the labels on the workload)

  #2  CRITICAL  web-loadbalancer  selector app=app-server matches no pod in this scope
      read   kubectl --context vcluster-docker_dev -n kdash-e2e get service web-loadbalancer -o jsonpath='{.spec.selector}{"\n"}'  # what the Service selects
      CHANGE kubectl --context vcluster-docker_dev -n kdash-e2e edit service web-loadbalancer  # make spec.selector match the pod labels (or fix the labels on the workload)

  #3  CRITICAL  web-nodeport  selector app=app-server matches no pod in this scope
      read   kubectl --context vcluster-docker_dev -n kdash-e2e get service web-nodeport -o jsonpath='{.spec.selector}{"\n"}'  # what the Service selects
      CHANGE kubectl --context vcluster-docker_dev -n kdash-e2e edit service web-nodeport  # make spec.selector match the pod labels (or fix the labels on the workload)


