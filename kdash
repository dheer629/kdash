      esc(a[1] " " a[2] " " a[3]), esc(a[1]), esc(a[2]), esc(a[3]), a[4], hmem(a[4] + 0), (a[5] == "-" ? -1 : a[5]), (a[5] == "-" ? "<span class=\"na\">no limit</span>" : hmem(a[5] + 0)),
