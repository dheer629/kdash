cycle_theme() { case "$THEME" in safe) THEME=dark ;; dark) THEME=light ;; light) THEME=mono ;; *) THEME=safe ;; esac; }

#-- namespace picker -------------------------------------------------------------
# Full-screen list of namespaces (API list, or what kdash can infer when listing is
# forbidden). Every namespace on screen is checked with "kubectl auth can-i list pods"
# (a self-review every account may run), so namespaces you cannot open are marked and
# refused inside the picker instead of failing after the switch.
# Type a number, a name, or text to filter; A = all namespaces.
# Sets PICKED (a namespace, or "*" for all); returns 1 when cancelled.
declare -A NSACC=(); PICK_MSG=""
ns_access_probe() {     # namespaces... -> NSACC[ns] = yes | no | ? (parallel, cached)
  local d="$TMPD/nsacc" ns n=0 todo=()
  mkdir -p "$d"
  for ns in "$@"; do [ -n "${NSACC[$ns]:-}" ] || todo+=("$ns"); done
  [ "${#todo[@]}" -gt 0 ] || return 0
  for ns in "${todo[@]}"; do
    ( r="$("${KC[@]}" auth can-i list pods -n "$ns" --request-timeout=8s 2>/dev/null | head -1)"
      case "$r" in yes) printf 'yes' ;; no) printf 'no' ;; *) printf '?' ;; esac > "$d/$ns" ) &
    n=$((n + 1)); [ $((n % 12)) = 0 ] && wait
  done
  wait
  for ns in "${todo[@]}"; do NSACC["$ns"]="$(cat "$d/$ns" 2>/dev/null || echo '?')"; done
  return 0
}
ns_pick() {
  local rows cols q="" line i n w ncol nrow maxr k cur items=() show=() recent=() cnt name mark src total msg="$PICK_MSG" acc nok=0 nno=0 b="" d="" g="" r="" x=""
  PICK_MSG=""
  declare -A PODS=() SEEN=()
  [ "$COLOR" = 1 ] && { b=$'\033[1m'; d=$'\033[90m'; g=$'\033[32m'; r=$'\033[31m'; x=$'\033[0m'; }
  rows="${KDASH_LINES:-$( (tput lines 2>/dev/null || echo "${LINES:-40}") )}"
  cols="${KDASH_COLUMNS:-$( (tput cols 2>/dev/null || echo "${COLUMNS:-160}") )}"
  printf '\033[H\033[2J%s Select namespace%s   context %s - reading the namespace list ...\n' "$b" "$x" "$CTX_NAME"
  list_namespaces > "$TMPD/nslist" 2>/dev/null
  if [ "$NSLIST_STATE" = ok ]; then src="namespace list from the API"
  else src="namespace list ${NSLIST_STATE} - showing namespaces kdash could infer; you can type any name"; fi
  [ -s "$MODEL/cluster_ns.tsv" ] && while IFS=$'\t' read -r name cnt _; do [ "$name" = NAMESPACE ] || PODS["$name"]="$cnt"; done < "$MODEL/cluster_ns.tsv"
  mapfile -t recent < <(recent_ns)
  for name in ${recent[@]+"${recent[@]}"}; do grep -qx -- "$name" "$TMPD/nslist" && [ -z "${SEEN[$name]:-}" ] && { items+=("$name"); SEEN["$name"]=r; }; done
  while IFS= read -r name; do [ -n "$name" ] && [ -z "${SEEN[$name]:-}" ] && { items+=("$name"); SEEN["$name"]=1; }; done < "$TMPD/nslist"
  total=${#items[@]}
  # access check: the first NS_PROBE_MAX namespaces (recent ones first), in parallel
  if [ "${KDASH_NS_PROBE:-1}" = 1 ] && [ "$total" -gt 0 ]; then
    printf '%s checking your access to %d namespace(s) ...%s\n' "$d" "$(( total < ${KDASH_NS_PROBE_MAX:-80} ? total : ${KDASH_NS_PROBE_MAX:-80} ))" "$x"
    ns_access_probe "${items[@]:0:${KDASH_NS_PROBE_MAX:-80}}"
    # readable namespaces first (recent order kept), then unknown, then no access
    local ord=()
    for acc in yes '?' no; do for name in "${items[@]}"; do [ "${NSACC[$name]:-?}" = "$acc" ] && ord+=("$name"); done; done
    items=("${ord[@]}")
  fi
  for name in ${items[@]+"${items[@]}"}; do case "${NSACC[$name]:-?}" in yes) nok=$((nok + 1)) ;; no) nno=$((nno + 1)) ;; esac; done
  while :; do
    show=()
    for name in ${items[@]+"${items[@]}"}; do [ -z "$q" ] || [[ "${name,,}" == *"${q,,}"* ]] && show+=("$name"); done
    n=${#show[@]}; w=8
    for name in ${show[@]+"${show[@]}"}; do [ $(( ${#name} + 16 )) -gt "$w" ] && w=$(( ${#name} + 16 )); done
    ncol=$(( cols / w )); [ "$ncol" -lt 1 ] && ncol=1; [ "$ncol" -gt 6 ] && ncol=6
    maxr=$(( rows - 10 )); [ "$maxr" -lt 3 ] && maxr=3
    nrow=$(( (n + ncol - 1) / ncol )); [ "$nrow" -gt "$maxr" ] && nrow=$maxr
    printf '\033[H\033[2J%s Select namespace%s   context %s   now: %s%s%s\n' "$b" "$x" "$CTX_NAME" "$b" "$NS" "$x"
    printf ' %s.  %d namespaces%s.\n' "$src" "$total" "$([ -n "$q" ] && printf ', %d match "%s"' "$n" "$q")"
    printf ' %saccess%s %s%d you can open%s  %s%d no access%s  %s(checked with kubectl auth can-i list pods)%s    * current  + recent  (n) pods\n\n' \
      "$d" "$x" "$g" "$nok" "$x" "$r" "$nno" "$x" "$d" "$x"
    for ((i = 0; i < nrow; i++)); do
      line=""
      for ((k = 0; k < ncol; k++)); do
        cur=$(( k * nrow + i )); [ "$cur" -lt "$n" ] || continue
        name="${show[$cur]}"; mark=" "; [ "${SEEN[$name]}" = r ] && mark="+"; [ "$name" = "$NS" ] && mark="*"
        cnt="${PODS[$name]:-}"; [ -n "$cnt" ] && cnt="($cnt)"
        case "${NSACC[$name]:-?}" in
          yes) line="$line$(printf '%4d %s %s%-*s%s %-7s' $((cur + 1)) "$mark" "$g" $(( w - 16 )) "$name" "$x" "$cnt")" ;;
          no)  line="$line$(printf '%4d %s %s%-*s%s %-7s' $((cur + 1)) "$mark" "$r" $(( w - 16 )) "$name x" "$x" "$cnt")" ;;
          *)   line="$line$(printf '%4d %s %-*s %-7s' $((cur + 1)) "$mark" $(( w - 16 )) "$name" "$cnt")" ;;
        esac
      done
      printf '%s\n' "$line"
    done
    [ "$n" -gt $(( nrow * ncol )) ] && printf '   ... %d more - type part of a name to narrow the list\n' $(( n - nrow * ncol ))
    [ "$n" -eq 0 ] && printf '   no namespace matches "%s" - Enter clears the filter, or type the exact name\n' "$q"
    [ -n "$msg" ] && printf '\n %s%s%s\n' "$r" "$msg" "$x"
    msg=""
    printf '\n\033[?25h number | name | text to filter | A = all namespaces | Enter = %s | q = cancel > ' "$([ -n "$q" ] && echo 'clear filter' || echo 'keep current')"
    IFS= read -r line </dev/tty || { printf '\033[?25l'; return 1; }
    printf '\033[?25l'
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    PICKED=""
    case "$line" in
      "") [ -n "$q" ] && { q=""; continue; }; return 1 ;;
      q|Q) return 1 ;;
      A|'*') PICKED="*" ;;
    esac
    if [ -z "$PICKED" ] && [[ "$line" =~ ^[0-9]+$ ]]; then
      if [ "$line" -ge 1 ] && [ "$line" -le "$n" ]; then PICKED="${show[$((line - 1))]}"
      else msg="no entry $line on the list"; continue; fi
    fi
    if [ -z "$PICKED" ]; then
      for name in ${items[@]+"${items[@]}"}; do [ "$name" = "$line" ] && PICKED="$name"; done
    fi
    if [ -z "$PICKED" ]; then
      q="$line"; show=()
      for name in ${items[@]+"${items[@]}"}; do [[ "${name,,}" == *"${q,,}"* ]] && show+=("$name"); done
      if [ "${#show[@]}" -eq 1 ]; then PICKED="${show[0]}"
      elif [ "${#show[@]}" -eq 0 ] && [[ "$line" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] && [ "${#line}" -le 63 ]; then
        PICKED="$line"; q=""            # not listed (list forbidden / partial): check it
      else continue; fi
    fi
    [ "$PICKED" = "*" ] && return 0
    ns_access_probe "$PICKED"
    if [ "${NSACC[$PICKED]}" = no ]; then
      msg="no access to $PICKED - your account cannot list pods there (kubectl auth can-i list pods -n $PICKED = no). Pick another namespace."
      q=""; continue
    fi
    return 0
  done
}

# switch the whole dashboard to another namespace ("*" = all namespaces).
# The new namespace is read first; on failure nothing changes and SWITCH_ERR says why.
switch_ns() {
  local new="$1" err="$TMPD/switch.err" tmp="$TMPD/spec.sw" scope
  SWITCH_ERR=""
  if [ "$new" = "*" ]; then scope=(--all-namespaces); else scope=(-n "$new"); fi
  [ "$new" = "*" ] && [ "$ALL_NS" = 1 ] && return 0
  [ "$new" = "$NS" ] && [ "$ALL_NS" = 0 ] && return 0
  if ! "${KC[@]}" get pods "${scope[@]}" --request-timeout=20s -o jsonpath="$SPEC_TPL" 2>"$err" | sed 's/^[[:space:]]*//' > "$tmp"; then
    SWITCH_ERR="$(sed -n '1{s/^Error from server ([A-Za-z]*): //;p}' "$err" | cut -c1-140)"; [ -n "$SWITCH_ERR" ] || SWITCH_ERR="kubectl failed"
    audit NS_SWITCH_DENIED "from=$NS to=${new/#\*/all-namespaces} reason=$SWITCH_ERR"
    rm -f "$tmp"; return 1
  fi
  toolkit_cancel; rm -rf "$TOOLKIT_DIR"; mkdir -p "$TOOLKIT_DIR"; TOOLKIT_NEXT=0
  session_close
  if [ "$new" = "*" ]; then ALL_NS=1; NS="(all namespaces)"; SCOPE=(--all-namespaces)
  else ALL_NS=0; NS="$new"; SCOPE=(-n "$NS"); remember_ns "$NS"; fi
  NS_FALLBACK=0
  mv -f "$tmp" "$SPEC"; SPEC_AT=0
  : > "$TOPC"; : > "$TOPP"; : > "$SVC"; : > "$HIST"; : > "$NHIST"; rm -f "$TMPD/forecast.tsv" "$TMPD/heat.tsv"; SVC_STATE="unread"
  io_reset
  : > "$WLS"; SPEC_AT=0; SPEC_OK=1; FETCH_NEXT=0
  if [ "$INTERACTIVE" = 1 ]; then fetch; else refresh_spec; refresh_top; fi
  build_model
  NPODS=$(awk -F'\t' '$1=="pods"{print $2}' "$MODEL/meta.tsv")
  session_start && session_tick
  audit NS_SWITCH "to=$NS pods=${NPODS:-0}"
  return 0
}

# BEGIN KDASH MODULES
# Runtime diagnostics, filtering and bounded background snapshots (embedded).
toolkit_clean() { LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'; }

doctor_classify() {
    if grep -qiE 'forbidden|cannot (get|list)' "$1"; then printf 'RBAC denied'
    elif grep -qiE 'Unauthorized|must be logged in|credentials|expired' "$1"; then printf 'authentication failed or expired'
    elif grep -qiE 'x509|certificate|TLS' "$1"; then printf 'TLS certificate validation failed'
    elif grep -qiE 'refused|no route|no such host|dial tcp|Unable to connect' "$1"; then printf 'endpoint unreachable'
    elif grep -qiE 'timeout|deadline exceeded|context canceled' "$1"; then printf 'request timed out'
    elif grep -qiE 'metrics.*not available|not find.*resource|not found|doesn.t have a resource' "$1"; then printf 'API or metrics unavailable'
    else printf 'read failed'; fi
}

doctor_run() {
    local endpoint code=0 probe="$TMPD/doctor.out" err="$TMPD/doctor.err"
    printf 'KDASH %s DOCTOR\nContext: %s\nNamespace: %s\nKubeconfig: %s\n' "$KDASH_VERSION" "$CTX_NAME" "$NS" "$KUBECONF_SHOWN"
    endpoint="$("${KC[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)"
    # Only display an endpoint without user info or query parameters.
    endpoint="${endpoint%%\?*}"; case "$endpoint" in *@*) endpoint='(endpoint contains user information; hidden)' ;; esac
    printf 'Endpoint: %s\n' "${endpoint:-not configured}" | toolkit_clean
    if "${KC[@]}" get pods "${SCOPE[@]}" -o name > "$probe" 2> "$err"; then
        printf 'PASS pods: readable (an empty namespace is valid)\n'
    else
        printf 'FAIL pods: %s\n' "$(doctor_classify "$err")"; code=1
        printf 'Next: kubectl --context %q -n %q get pods --request-timeout=%ss\n' "$CTX_NAME" "${NS/\(all namespaces\)/default}" "$REQUEST_TIMEOUT"
        printf 'For a local vcluster, check its existing runtime and connection; keep recovery kubeconfigs separate.\n'
    fi
    local resource
    for resource in nodes services endpointslices.discovery.k8s.io persistentvolumeclaims events; do
        if [ "$resource" = nodes ]; then
            "${KC[@]}" get "$resource" -o name > "$probe" 2> "$err"
        else
            "${KC[@]}" get "$resource" "${SCOPE[@]}" -o name > "$probe" 2> "$err"
        fi
        if [ $? = 0 ]; then printf 'PASS %s: readable\n' "$resource"
        else printf 'INFO %s: %s (capability unavailable)\n' "$resource" "$(doctor_classify "$err")"; fi
    done
    if "${KC[@]}" top pod "${SCOPE[@]}" --no-headers > "$probe" 2> "$err"; then
        printf 'PASS metrics: pod CPU/memory readable\n'
    else
        printf 'INFO metrics: %s; requests/limits and object health remain available\n' "$(doctor_classify "$err")"
        printf 'Next: inspect the existing Metrics API/metrics-server and your metrics permissions.\n'
    fi
    if [ -d "$REPORT_DIR" ] && [ -w "$REPORT_DIR" ] || { mkdir -p "$REPORT_DIR" 2>/dev/null && [ -w "$REPORT_DIR" ]; }; then
        printf 'PASS local reports: writable\n'
    else printf 'FAIL local reports: directory is not writable\n'; code=1; fi
    printf 'Audit: %s\nRead-only checks complete; no cluster changes made.\n' "${AUDIT_FILE:-$AUDIT_DIR}"
    audit DOCTOR "result=$code context=$CTX_NAME namespace=$NS"
    return "$code"
}

toolkit_init() {
    TOOLKIT_DIR="$TMPD/toolkit"; mkdir -p "$TOOLKIT_DIR"
    FETCH_PID=""; FETCH_NEXT=0; FETCH_FAILURES=0; FETCH_SUCCESS=0
    TOOLKIT_PID=""; TOOLKIT_NEXT=0
    TOOLKIT_REQUESTED=0
}

filter_spec() {
    awk -F'|' -v sf="${KDASH_STATUS_FILTER:-}" -v nf="${KDASH_NODE_FILTER:-}" \
        -v wf="${KDASH_WORKLOAD_FILTER:-}" -v uh="${KDASH_UNHEALTHY:-0}" '
    function flush(  a,st,w,ok,i) {
        if (!n) return
        split(row[1],a,"|"); st=a[3]; if (waiting!="") st=waiting
        if (st=="Running" && !ready) st="NotReady"
        w=a[10]; sub(/-[a-z0-9]+$/, "", w)
        ok=(sf=="" || st~sf) && (nf=="" || a[4]==nf) && (wf=="" || w~wf)
        if (uh==1 && (st=="Succeeded" || st=="Completed" || (st=="Running" && ready))) ok=0
        if(ok) for(i=1;i<=n;i++) print row[i]
    }
    $1=="P" {flush(); n=0; waiting=""; ready=1}
    {row[++n]=$0; if($1=="S") {if($3!="true")ready=0; if($6!="")waiting=$6}}
    END {flush()}' "$1"
}

build_model() {
    local original="$SPEC"
    filter_spec "$original" > "$TMPD/spec.filtered"
    SPEC="$TMPD/spec.filtered"; build_model_core; local rc=$?; SPEC="$original"
    return "$rc"
}

# Workers never modify the displayed model. A complete snapshot is adopted only
# after the worker exits. A hung credential plugin is also bounded by the guard.
fetch_worker() (
    trap - EXIT INT TERM HUP
    local parent="$TMPD" job="$TMPD/fetch-job" name
    mkdir -p "$job"
    for name in spec top topprev nodes topnode svc cluster workloads; do cp -f "$parent/$name" "$job/$name" 2>/dev/null || : > "$job/$name"; done
    cp -f "$parent"/*.updated "$job/" 2>/dev/null || true
    [ ! -d "$parent/io" ] || cp -a "$parent/io" "$job/io"
    TMPD="$job"; SPEC="$job/spec"; TOPC="$job/top"; TOPP="$job/topprev"
    NODES="$job/nodes"; TOPN_F="$job/topnode"; SVC="$job/svc"; CLUS="$job/cluster"; WLS="$job/workloads"
    local now; now=$(date +%s)
    if [ $((now - SPEC_AT)) -ge "$SPEC_TTL" ] || [ "$SPEC_OK" != 1 ]; then refresh_spec; fi
    if [ "$now" -ge "${METRICS_NEXT:-0}" ]; then
        [ "$TOPN_STATE" != forbidden ] || TOPN_STATE=unread
        refresh_top
        if [ "$TOP_OK" = 1 ]; then METRICS_NEXT=0; else METRICS_NEXT=$((now + 30)); fi
    fi
    IO_PID=""; io_tick
    if [ -n "$IO_PID" ]; then wait "$IO_PID" 2>/dev/null || true; IO_PID=""; io_tick; fi
    [ -z "$IO_PID" ] || { wait "$IO_PID" 2>/dev/null || true; IO_PID=""; }
    for name in SPEC_OK SPEC_AT TOP_OK TOP_AT NODES_STATE SVC_STATE TOPN_STATE TOPN_OK CLUSTER_STATE WL_STATE WL_KINDS TOPA_STATE NS_SCAN_AT METRICS_NEXT IO_STATE IO_SRC IO_REASON IO_LAST IO_DETECT_AT IO_SAMPLE_AT IO_SRC_PATH; do
        printf '%s\t%s\n' "$name" "${!name:-}"
    done > "$job/state"
    date +%s > "$job/finished"
)

fetch_adopt() {
    [ -n "${FETCH_PID:-}" ] || return 0
    kill -0 "$FETCH_PID" 2>/dev/null && return 0
    wait "$FETCH_PID" 2>/dev/null || true; FETCH_PID=""
    local job="$TMPD/fetch-job" name value
    [ -f "$job/finished" ] || { FETCH_NEXT=$(( $(date +%s) + 5 )); return 0; }
    for name in spec top topprev nodes topnode svc cluster workloads; do [ ! -f "$job/$name" ] || mv -f "$job/$name" "$TMPD/$name"; done
    cp -f "$job"/*.updated "$TMPD/" 2>/dev/null || true
    if [ -d "$job/io" ]; then rm -rf "$TMPD/io"; mv "$job/io" "$TMPD/io"; fi
    while IFS=$'\t' read -r name value; do
        case "$name" in SPEC_OK|SPEC_AT|TOP_OK|TOP_AT|NODES_STATE|SVC_STATE|TOPN_STATE|TOPN_OK|CLUSTER_STATE|WL_STATE|WL_KINDS|TOPA_STATE|NS_SCAN_AT|METRICS_NEXT|IO_STATE|IO_SRC|IO_REASON|IO_LAST|IO_DETECT_AT|IO_SAMPLE_AT|IO_SRC_PATH) printf -v "$name" '%s' "$value" ;; esac
    done < "$job/state"
    if [ "$SPEC_OK" = 1 ]; then FETCH_SUCCESS=$(cat "$job/finished"); FETCH_FAILURES=0
    else FETCH_FAILURES=$(( FETCH_FAILURES + 1 )); fi
    local delay="$INTERVAL"
    [ "$FETCH_FAILURES" = 0 ] || delay=$(( 2 ** (FETCH_FAILURES > 5 ? 5 : FETCH_FAILURES) ))
    FETCH_NEXT=$(( $(date +%s) + ${delay%.*} ))
    build_model; session_tick; FETCH_AT=$(date +%s)
}

fetch() {
    if [ "${INTERACTIVE:-0}" != 1 ]; then fetch_sync; return; fi
    fetch_adopt
    [ -z "${FETCH_PID:-}" ] || return 0
    [ "$(date +%s)" -ge "${FETCH_NEXT:-0}" ] || return 0
    fetch_worker & FETCH_PID=$!
}

toolkit_tick() {
    if [ -n "${TOOLKIT_PID:-}" ] && ! kill -0 "$TOOLKIT_PID" 2>/dev/null; then
        wait "$TOOLKIT_PID" 2>/dev/null || true; TOOLKIT_PID=""
        if [ -d "$TMPD/toolkit-next" ]; then
            rm -rf "$TOOLKIT_DIR"; mv "$TMPD/toolkit-next" "$TOOLKIT_DIR"
        fi
        TOOLKIT_NEXT=$(( $(date +%s) + 30 ))
    fi
    [ "${TOOLKIT_REQUESTED:-0}" = 1 ] || return 0
    [ -z "${TOOLKIT_PID:-}" ] || return 0
    [ "$(date +%s)" -ge "${TOOLKIT_NEXT:-0}" ] || return 0
    (
        trap - EXIT INT TERM HUP
        local next="$TMPD/toolkit-next"
        mkdir -p "$next"; cp -f "$TOOLKIT_DIR"/* "$next/" 2>/dev/null || true
        TOOLKIT_DIR="$next"
        events_collect; health_collect
        doctor_run > "$TOOLKIT_DIR/doctor.txt"
    ) & TOOLKIT_PID=$!
}

toolkit_cancel() {
    local pid
    for pid in "${FETCH_PID:-}" "${TOOLKIT_PID:-}"; do
        [ -z "$pid" ] || { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }
    done
    FETCH_PID=""; TOOLKIT_PID=""
    rm -rf "$TMPD/fetch-job" "$TMPD/toolkit-next"
}

toolkit_panel() {
    local view="$1"
    # Standard header (tab bar, clock, context, health line, warnings), then the panel body.
    HEADER_ONLY=1 render_core
    case "$view" in
        services) health_render_services ;; storage) health_render_storage ;;
        events) events_render ;; explain) explain_render "${NS/\(all namespaces\)/}" "${EXPLAIN_POD:-}" ;;
        doctor) if [ -f "$TOOLKIT_DIR/doctor.txt" ]; then cat "$TOOLKIT_DIR/doctor.txt"; else printf 'Checking capabilities in background...\n'; fi ;;
    esac | toolkit_clean > "$BODYF"
    printf '8 services | 9 storage | E events | ! explain | i inspect | : commands | q quit\n' > "$FTRF"
}

render() {
    case "$VIEW" in services|storage|events|explain|doctor) toolkit_panel "$VIEW" ;;
        *) render_core ;;
    esac
    local age=never status=not-collected
    [ "${SPEC_AT:-0}" = 0 ] || age="$(( $(date +%s) - SPEC_AT ))s"
    [ "${SPEC_OK:-0}" != 1 ] || status=fresh
    [ "${SPEC_OK:-0}" = 1 ] || { [ ! -s "$SPEC" ] || status=STALE; }
    printf 'Data pods=%s age=%s metrics=%s | Enter/i inspect | 8 services 9 storage E events ! explain : commands\n' \
        "$status" "$age" "$([ "$TOP_OK" = 1 ] && echo available || echo unavailable)" >> "$HDRF"
    local source updated
    for source in nodes svc; do
        updated="$(cat "$TMPD/$source.updated" 2>/dev/null || printf 0)"
        case "$updated" in ''|*[!0-9]*) updated=0 ;; esac
        if [ "$updated" != 0 ] && [ $(( $(date +%s) - updated )) -gt "$SPEC_TTL" ]; then
            printf 'STALE %s: last successful read %ss ago\n' "$source" "$(( $(date +%s) - updated ))" >> "$HDRF"
        fi
    done
}

toolkit_filters_changed() {
    local now="${KDASH_LABEL_SELECTOR:-}|${KDASH_STATUS_FILTER:-}|${KDASH_NODE_FILTER:-}|${KDASH_WORKLOAD_FILTER:-}|${KDASH_UNHEALTHY:-0}"
    if [ "$now" != "${TOOLKIT_FILTER_STATE:-}" ]; then
        toolkit_cancel; SPEC_AT=0; FETCH_NEXT=0; LAST=0
        TOOLKIT_FILTER_STATE="$now"; build_model
    fi
}

toolkit_export() {
    local dir="$1" item
    [ -d "$dir" ] || return 0
    for item in services storage events explain; do
        case "$item" in services) health_render_services ;; storage) health_render_storage ;;
            events) events_render ;; explain) explain_render ;; esac | toolkit_clean > "$dir/$item.txt"
    done
    mkdir -p "$dir/diagnostics"
    cp -f "$TOOLKIT_DIR"/*.tsv "$TOOLKIT_DIR"/*.status "$dir/diagnostics/" 2>/dev/null || true
}

# Kubernetes API Events and deterministic incident evidence. This source module
# is embedded into the deployable Bash CLI; it adds no runtime dependencies.
# events.tsv: NS KIND NAME UID TYPE REASON COUNT FIRST LAST MESSAGE (TSV).
# UID is the involved resource UID, not the Event UID. API Event UIDs are used
# internally to discard duplicate records, never to merge distinct Events.

events_context() {
    local value="${CTX_NAME:-${CTX:-}}" arg next=0
    for arg in "${KC[@]}"; do
        if [ "$next" = 1 ]; then value="$arg"; next=0; continue; fi
        case "$arg" in
            --context) next=1 ;;
            --context=*) value="${arg#*=}" ;;
        esac
    done
    printf '%s' "${value:-<selected-context>}"
}

events_scope_key() {
    local arg next=0 config=""
    for arg in "${KC[@]}"; do
        if [ "$next" = 1 ]; then config="$arg"; next=0; continue; fi
        case "$arg" in
            --kubeconfig) next=1 ;;
            --kubeconfig=*) config="${arg#*=}" ;;
        esac
    done
    printf '%q|%q|%q|%q' "$(events_context)" "$config" "${NS:-}" "${ALL_NS:-0}"
}

events_text() {
    # Prevent object/event strings from injecting terminal controls or rows.
    LC_ALL=C awk 'BEGIN { ORS = "" } { gsub(/[[:cntrl:]]/, " "); if (NR > 1) printf " "; printf "%s", $0 }'
}

events_command() {    # namespace, verb/resource/arguments: printable Bash command
    local namespace="$1" arg next=0 config=""
    shift
    for arg in "${KC[@]}"; do
        if [ "$next" = 1 ]; then config="$arg"; next=0; continue; fi
        case "$arg" in
            --kubeconfig) next=1 ;;
            --kubeconfig=*) config="${arg#*=}" ;;
        esac
    done
    printf 'kubectl --context %q' "$(events_context)"
    [ -z "$config" ] || printf ' --kubeconfig %q' "$config"
    printf ' %q' "$@"
    if [ -n "$namespace" ]; then printf ' -n %q' "$namespace"; fi
    printf ' --request-timeout=10s\n'
}

events_empty_table() {
    printf 'NS\tKIND\tNAME\tUID\tTYPE\tREASON\tCOUNT\tFIRST\tLAST\tMESSAGE\n'
}

events_collect() {
    local directory="${TOOLKIT_DIR:?TOOLKIT_DIR must name a private directory}"
    local stem="$directory/events.collect.${BASHPID:-$$}" scope status error template
    mkdir -p -- "$directory" || return 1
    scope="$(events_scope_key)"
    if [ ! -f "$directory/events.scope" ] || [ "$(cat -- "$directory/events.scope")" != "$scope" ]; then
        # A failed read after switching scope must not reveal an older scope.
        events_empty_table > "$directory/events.tsv"
        rm -f -- "$directory/events.updated"
    fi
    printf '%s\n' "$scope" > "$directory/events.scope"
    date +%s > "$directory/events.checked"

    # Go's quoted strings keep embedded newlines and tabs inside one field.
    # The portable awk decoder below flattens controls without eval or JSON tools.
    template='{{range .items}}{{printf "%q\t%q\t%q\t%q\t%q\t%q\t" .metadata.namespace .involvedObject.kind .involvedObject.name .involvedObject.uid .type .reason}}{{if .series.count}}{{.series.count}}{{else if .count}}{{.count}}{{else}}1{{end}}{{printf "\t"}}{{if .firstTimestamp}}{{printf "%q" .firstTimestamp}}{{else if .eventTime}}{{printf "%q" .eventTime}}{{else}}{{printf "%q" .metadata.creationTimestamp}}{{end}}{{printf "\t"}}{{if .series.lastObservedTime}}{{printf "%q" .series.lastObservedTime}}{{else if .lastTimestamp}}{{printf "%q" .lastTimestamp}}{{else if .eventTime}}{{printf "%q" .eventTime}}{{else}}{{printf "%q" .metadata.creationTimestamp}}{{end}}{{printf "\t%q\t%q\n" .message .metadata.uid}}{{end}}'

    status=ok; error=""
    if "${KC[@]}" get events "${SCOPE[@]}" --request-timeout=10s -o go-template="$template" > "$stem.raw" 2> "$stem.err"; then
        if LC_ALL=C awk '
            BEGIN { FS = "\t"; OFS = "\t" }
            function clean(s,    i,c,e,n,out) {
                if (s == "" || s == "<nil>" || s == "<no value>" || substr(s, 1, 3) == "%!q") return "-"
                if (substr(s, 1, 1) == "\"" && substr(s, length(s), 1) == "\"") s = substr(s, 2, length(s) - 2)
                out = ""
                for (i = 1; i <= length(s); i++) {
                    c = substr(s, i, 1)
                    if (c == "\\" && i < length(s)) {
                        e = substr(s, ++i, 1)
                        if (e == "\\" || e == "\"") c = e
                        else if (e ~ /^[abfnrtv]$/) c = " "
                        else if (e == "x") { i += 2; c = " " }
                        else if (e == "u" || e == "U") {
                            n = (e == "u" ? 4 : 8); c = "\\" e substr(s, i + 1, n); i += n
                        } else c = "\\" e
                    }
                    out = out c
                }
                gsub(/[[:cntrl:]]/, " ", out)
                gsub(/[[:space:]]+/, " ", out)
                sub(/^ /, "", out); sub(/ $/, "", out)
                return out == "" ? "-" : out
            }
            function timekey(s,    fraction) {
                if (s == "-") return ""
                fraction = (substr(s, 20, 1) == "." ? substr(s, 21) : "")
                sub(/[^0-9].*$/, "", fraction)
                return substr(s, 1, 19) "." substr(fraction "000000000", 1, 9)
            }
            NF != 11 { bad = 1; next }
            {
                for (i = 1; i <= 11; i++) v[i] = clean($i)
                if (v[7] !~ /^[0-9]+$/ || v[7] + 0 < 1) v[7] = 1
                key = (v[11] == "-" ? "row:" NR : "uid:" v[11])
                row = v[1]; for (i = 2; i <= 10; i++) row = row OFS v[i]
                if (!(key in rows) || timekey(v[9]) >= last[key]) { rows[key] = row; last[key] = timekey(v[9]) }
            }
            END { if (bad) exit 2; for (key in rows) print last[key], rows[key] }
        ' "$stem.raw" > "$stem.rows"; then
            events_empty_table > "$stem.tsv"
            if LC_ALL=C sort -t $'\t' -k1,1r -k2,2 -k4,4 "$stem.rows" | cut -f2- >> "$stem.tsv"; then
                if [ "$(cat -- "$directory/events.scope")" != "$scope" ]; then
                    rm -f -- "$stem.raw" "$stem.err" "$stem.rows" "$stem.tsv"
                    return 1
                fi
                mv -f -- "$stem.tsv" "$directory/events.tsv"
                date +%s > "$directory/events.updated"
            else
                status=error; error="Events could not be saved; check the local toolkit directory."
            fi
        else
            status=error; error="Events response could not be parsed; coverage is unknown."
        fi
    elif LC_ALL=C grep -qiE 'forbidden|cannot (list|get).*events' "$stem.err"; then
        status=forbidden; error="Events access denied; check list events permission for this scope."
    elif LC_ALL=C grep -qiE "doesn.t have a resource type|could not find the requested resource|resource.*not found|not supported" "$stem.err"; then
        status=unavailable; error="The Kubernetes Events API is unavailable for this connection."
    else
        status=error; error="Events request failed; check connection, TLS, authentication and timeout with --doctor."
    fi
    if [ "$(cat -- "$directory/events.scope")" != "$scope" ]; then
        rm -f -- "$stem.raw" "$stem.err" "$stem.rows" "$stem.tsv"
        return 1
    fi
    # Never publish raw kubectl stderr: authentication plugins can include secrets.
    printf '%s\n' "$status" > "$directory/events.status"
    printf '%s\n' "$error" > "$directory/events.error"
    rm -f -- "$stem.raw" "$stem.err" "$stem.rows" "$stem.tsv"
    [ "$status" = ok ]
}

events_cache_valid() {
    [ -f "${TOOLKIT_DIR:-}/events.scope" ] &&
        [ "$(cat -- "$TOOLKIT_DIR/events.scope")" = "$(events_scope_key)" ]
}

events_header() {    # filtered namespace (empty = all), optional pod
    local namespace="${1:-}" pod="${2:-}" status=unknown updated="" now age
    printf 'Context: %s | Scope: %s' "$(events_context | events_text)" "$(printf '%s' "${namespace:-all namespaces}" | events_text)"
    [ -z "$pod" ] || printf ' | Pod: %s' "$(printf '%s' "$pod" | events_text)"
    printf '\n'
    if ! events_cache_valid; then
        if [ -n "${TOOLKIT_PID:-}" ]; then
            printf 'Coverage: collecting (first read in progress; values appear when it completes).\n'
        else
            printf 'Coverage: unknown (no Events collected for this context and scope).\n'
        fi
        return 0
    fi
    [ ! -f "$TOOLKIT_DIR/events.status" ] || IFS= read -r status < "$TOOLKIT_DIR/events.status" || true
    [ ! -f "$TOOLKIT_DIR/events.updated" ] || IFS= read -r updated < "$TOOLKIT_DIR/events.updated" || true
    printf 'Coverage: %s' "$(printf '%s' "$status" | events_text)"
    case "$updated" in
        ''|*[!0-9]*) printf ' | No successful Events observation.\n' ;;
        *) now=$(date +%s); age=$((now - updated)); [ "$age" -ge 0 ] || age=0
            printf ' | Last successful read: %s (%ss ago)%s\n' \
                "$(date -d "@$updated" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null || printf '%s' "$updated")" "$age" \
                "$([ "$status" = ok ] || printf ' | STALE retained evidence')" ;;
    esac
    if [ "$status" != ok ] && [ -s "$TOOLKIT_DIR/events.error" ]; then
        printf '  %s\n' "$(events_text < "$TOOLKIT_DIR/events.error")"
    fi
    printf 'These are Kubernetes API Events; local session change records are separate.\n'
}

events_rows() {    # namespace, pod, warnings-only (0/1); no API calls
    local namespace="${1:-}" pod="${2:-}" warnings="${3:-0}"
    events_cache_valid && [ -f "$TOOLKIT_DIR/events.tsv" ] || return 0
    LC_ALL=C awk -F '\t' -v ns="$namespace" -v pod="$pod" -v warn="$warnings" '
        NR > 1 && (ns == "" || $1 == ns) && (pod == "" || ($2 == "Pod" && $3 == pod)) && (!warn || $5 == "Warning") { print }
    ' "$TOOLKIT_DIR/events.tsv"
}

events_render() {    # optional namespace, pod; rendering never calls the API
    local namespace="${1:-}" pod="${2:-}" maximum="${KDASH_EVENTS_TOP:-100}"
    if [ "$#" -eq 0 ] && [ "${ALL_NS:-0}" != 1 ]; then namespace="${NS:-}"; fi
    case "$maximum" in ''|*[!0-9]*) maximum=100 ;; esac
    [ "$maximum" -ge 1 ] && [ "$maximum" -le 500 ] || maximum=100
    printf 'KUBERNETES EVENTS\n'
    events_header "$namespace" "$pod"
    events_rows "$namespace" "$pod" | LC_ALL=C awk -F '\t' -v limit="$maximum" '
        {
            count++
            if (count > limit) next
            printf "\n%s/%s %s | %s | %s | count %s\n", $1, $2, $3, $5, $6, $7
            printf "  First: %s | Last: %s | Resource UID: %s\n  %s\n", $8, $9, $4, $10
        }
        END {
            if (!count) print "No matching retained Kubernetes Events; this does not establish application health."
            else if (count > limit) printf "\nShowing newest %d of %d matching events.\n", limit, count
        }
    '
}

explain_render() {    # optional namespace, pod; hypotheses never assert causation
    local namespace="${1:-}" pod="${2:-}" ens kind name uid type reason count first last message
    local shown=0 category key previous="|" object_kind
    if [ "$#" -eq 0 ] && [ "${ALL_NS:-0}" != 1 ]; then namespace="${NS:-}"; fi
    printf 'INCIDENT EVIDENCE AND POSSIBLE EXPLANATIONS\n'
    events_header "$namespace" "$pod"
    printf 'Events describe observations, including historical failures. Timing alone does not establish a cause.\n'
    if [ -n "${MODEL:-}" ] && [ -f "$MODEL/pods.tsv" ]; then
        LC_ALL=C awk -F '\t' -v ns="$namespace" -v pod="$pod" '
            NR > 1 && (ns == "" || $2 == ns) && (pod == "" || $3 == pod) {
                line = "Cached pod fact: " $2 "/" $3 " status=" $4 " ready=" $5 " cumulative restarts=" $6 " node=" $7
                gsub(/[[:cntrl:]]/, " ", line); print line
            }
        ' "$MODEL/pods.tsv"
        printf 'Pod facts use the dashboard model; their collection time can differ from Events.\n'
    fi
    while IFS=$'\t' read -r ens kind name uid type reason count first last message; do
        [ -n "$ens" ] || continue
        category=other
        case "$reason" in
            FailedScheduling|SchedulingGated) category=scheduling ;;
            FailedMount|FailedAttachVolume|FailedBinding|ProvisioningFailed|FailedMapVolume|FailedUnmapVolume|VolumeFailedMount) category=storage ;;
            Unhealthy|ProbeWarning) category=probe ;;
            ErrImagePull|ImagePullBackOff|InvalidImageName|InspectFailed|ErrImageNeverPull) category=image ;;
            BackOff) category=restart ;;
            OOMKilling|OOMKilled) category=memory ;;
        esac
        if printf '%s' "$message" | LC_ALL=C grep -qiE 'failed to pull|pull image|imagepull|manifest unknown|back-off pulling'; then category=image; fi
        key="$ens/$kind/$name/$uid/$category"
        case "$previous" in *"|$key|"*) continue ;; esac
        previous="$previous$key|"; shown=$((shown + 1))
        printf '\nObserved: %s/%s %s | %s | count %s | first %s | last %s | resource UID %s\n' "$ens" "$kind" "$name" "$reason" "$count" "$first" "$last" "$uid"
        printf '  Event fact: %s\n' "$message"
        case "$category" in
            scheduling) printf '  Possible explanation: scheduler constraints, capacity or an unbound claim may block placement. Read the scheduler message before deciding which applies.\n' ;;
            storage) printf '  Possible explanation: volume binding, provisioning, attachment or mounting may be blocking startup. This event does not establish volume fullness.\n' ;;
            probe) printf '  Possible explanation: a readiness, liveness or startup probe may be failing. Check its configuration and application evidence; one event does not establish an ongoing outage.\n' ;;
            image) printf '  Possible explanation: image reference, registry access or pull credentials may prevent container startup. Do not expose credentials when collecting evidence.\n' ;;
            restart) printf '  Possible explanation: a container may be repeatedly exiting. The event alone does not identify why it exited.\n' ;;
            memory) printf '  Possible explanation: the event reports memory pressure or a kill at its timestamp; it is not a current memory measurement.\n' ;;
            *) printf '  Possible explanation: this warning needs object-specific investigation; its presence alone does not establish the underlying cause.\n' ;;
        esac
        object_kind="$(printf '%s' "$kind" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
        printf '  Next read-only check: '
        events_command "$ens" describe "$object_kind" "$name"
        if [ "$category" = storage ]; then
            printf '  Next read-only check: '; events_command "$ens" get pvc
        elif [ "$kind" = Pod ]; then
            case "$category" in
                restart|memory) printf '  Next read-only check: '; events_command "$ens" logs "$name" --all-containers --previous --tail=100 ;;
                probe) printf '  Next read-only check: '; events_command "$ens" logs "$name" --all-containers --tail=100 --since=5m ;;
            esac
        fi
        [ "$shown" -lt 20 ] || break
    done < <(events_rows "$namespace" "$pod" 1)
    if [ "$shown" = 0 ]; then
        printf '\nNo matching retained warning event evidence. Coverage gaps, event expiry and failures without Events remain possible.\n'
        if [ -n "$pod" ]; then
            printf 'Next read-only check: '; events_command "$namespace" describe pod "$pod"
        fi
    fi
    printf '\nCompare current readiness, resource identities, logs and workload conditions before deciding on a change.\n'
}

# Service and storage diagnostics. Embedded into kdash before main; also sourceable
# by fixture tests. All Kubernetes reads use the caller's audited KC array.
# Files live in the caller's private TOOLKIT_DIR. Missing/unreadable sources are
# explicitly unknown. No cluster writes, shell evaluation, or automatic repair.

health__status() {
  local source="$1" state="$2" detail="$3"
  printf '%s\t%s\t%s\n' "$state" "$(date +%s)" "$detail" > "$TOOLKIT_DIR/health-$source.status"
}

health__state() {
  local source="$1" state epoch detail
  if [ -r "$TOOLKIT_DIR/health-$source.status" ]; then
    IFS=$'\t' read -r state epoch detail < "$TOOLKIT_DIR/health-$source.status"
    printf '%s' "${state:-unknown}"
  else printf unknown; fi
}

health__failure() {
  local source="$1" err="$2" state=error detail='read failed; source unknown'
  if grep -qiE 'forbidden|cannot (list|get)|returned error: 403' "$err"; then
    state=forbidden; detail='read denied by RBAC; source unknown'
  elif grep -qiE 'unauthorized|must be logged in|returned error: 401' "$err"; then
    state=auth-error; detail='authentication failed; source unknown'
  elif grep -qiE 'doesn.t have a resource type|could not find the requested resource|not found' "$err"; then
    state=unavailable; detail='API or source unavailable; source unknown'
  elif grep -qiE 'x509|certificate|TLS handshake' "$err"; then
    state=tls-error; detail='TLS verification failed; source unknown'
  elif grep -qiE 'timed out|timeout|deadline exceeded' "$err"; then
    state=timeout; detail='read timed out; source unknown'
  elif grep -qiE 'connection refused|no route|unable to connect|connection reset|no such host' "$err"; then
    state=unreachable; detail='API or metrics endpoint unreachable; source unknown'
  fi
  health__status "$source" "$state" "$detail"
}

health__read() {
  local source="$1" resource="$2" scoped="$3" template="$4"
  local tmp="$TOOLKIT_DIR/health-$source.new" err="$TOOLKIT_DIR/health-$source.err" rc
  if [ "$scoped" = yes ]; then
    if "${KC[@]}" get "$resource" "${SCOPE[@]}" --request-timeout="${KDASH_HEALTH_TIMEOUT:-12s}" -o "go-template=$template" > "$tmp" 2> "$err"; then rc=0; else rc=$?; fi
  else
    if "${KC[@]}" get "$resource" --request-timeout="${KDASH_HEALTH_TIMEOUT:-12s}" -o "go-template=$template" > "$tmp" 2> "$err"; then rc=0; else rc=$?; fi
  fi
  if [ "$rc" = 0 ]; then
    mv -f "$tmp" "$TOOLKIT_DIR/health-$source.raw"
    health__status "$source" ok 'successful API read; empty means no objects in this scope'
  else
    rm -f "$tmp"; : > "$TOOLKIT_DIR/health-$source.raw"
    health__failure "$source" "$err"
  fi
  return 0
}

health__volume_metrics() {
  local url="${PROM_URL:-${KDASH_PROM_URL:-}}" service="${PROM_SVC:-${KDASH_PROM_SVC:-}}"
  local path='' query selection ns_ s_ rc=1
  local out="$TOOLKIT_DIR/health-volume-metrics.raw" err="$TOOLKIT_DIR/health-volume-metrics.err"
  : > "$out"; : > "$TOOLKIT_DIR/health-volume-usage.tsv"; : > "$err"
  # Only configured Prometheus or the existing IO collector's detected source.
  # Do not scan services/nodes or introduce another metrics component.
  if [ -z "$url" ] && [ -z "$service" ]; then
    case "${IO_STATE:-}" in
      prom-url) url="${PROM_URL:-}" ;;
      prom-svc) path="${IO_SRC_PATH:-}" ;;
    esac
  fi
  if [ -n "$service" ]; then
    ns_="${NS:-default}"; s_="$service"
    case "$s_" in */*) ns_="${s_%%/*}"; s_="${s_#*/}" ;; esac
    if [ "${ALL_NS:-0}" = 1 ] && [ "$ns_" = "${NS:-}" ]; then
      health__status volume-metrics unknown 'use namespace/service:port with --prom-svc for all-namespace collection'; return 0
    fi
    path="/api/v1/namespaces/$ns_/services/$s_/proxy"
  fi
  if [ -z "$url" ] && [ -z "$path" ]; then
    health__status volume-metrics unknown 'no configured or existing Prometheus source; measured PVC usage unknown'; return 0
  fi
  # Namespace names cannot contain quotes; percent-encode the fixed selector.
  if [ "${ALL_NS:-0}" = 1 ]; then selection='namespace!=""'; else selection="namespace=\"${NS:-default}\""; fi
  query="{__name__=~\"kubelet_volume_stats_(used|capacity|available)_bytes\",$selection}"
  query="$(printf '%s' "$query" | sed -e 's/%/%25/g' -e 's/{/%7B/g' -e 's/}/%7D/g' -e 's/"/%22/g' -e 's/|/%7C/g' -e 's/=/%3D/g' -e 's/~/%7E/g' -e 's/!/%21/g' -e 's/,/%2C/g' -e 's/(/%28/g' -e 's/)/%29/g')"
  if [ -n "$url" ]; then
    if ! command -v curl >/dev/null 2>&1; then
      health__status volume-metrics unavailable 'configured URL requires optional curl; measured PVC usage unknown'; return 0
    fi
    if curl -fsS --connect-timeout 5 --max-time 12 --globoff "${url%/}/federate?match[]=$query" > "$out" 2> "$err"; then rc=0; else rc=$?; fi
  else
    if "${KC[@]}" get --raw "$path/federate?match[]=$query" --request-timeout="${KDASH_HEALTH_TIMEOUT:-12s}" > "$out" 2> "$err"; then rc=0; else rc=$?; fi
  fi
  if [ "$rc" != 0 ]; then
    : > "$out"; health__failure volume-metrics "$err"; return 0
  fi
  awk -v scope="${NS:-default}" -v all="${ALL_NS:-0}" -v now="$(date +%s)" '
    function label(k, s,   p,r) { p=index("," s, "," k "=\""); if (!p) return ""; r=substr("," s,p+length(k)+3); return substr(r,1,index(r,"\"")-1) }
    /^kubelet_volume_stats_(used|capacity|available)_bytes\{/ {
      b=index($0,"{"); e=index($0,"}"); if (!b || !e) next
      metric=substr($0,1,b-1); labels=substr($0,b+1,e-b-1)
      ns=label("namespace",labels); pvc=label("persistentvolumeclaim",labels)
      if (ns=="" || pvc=="" || (!all && ns!=scope)) next
      rest=substr($0,e+1); sub(/^[ \t]+/,"",rest); split(rest,v,/[ \t]+/)
      if (v[1] !~ /^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$/) next
      ts=(v[2] ~ /^[0-9]+$/ ? v[2]/1000 : now); origin=(v[2] ~ /^[0-9]+$/ ? "exporter" : "collection")
      k=ns SUBSEP pvc; mk=k SUBSEP metric
      # Duplicate scrape series are never summed; use latest timestamp, max at a tie.
      if (!(mk in seen) || ts>T[mk] || (ts==T[mk] && v[1]+0>V[mk])) { V[mk]=v[1]+0; T[mk]=ts; O[mk]=origin; seen[mk]=1 }
      keys[k]=ns "\t" pvc
    }
    END { for (k in keys) {
      printf "%s",keys[k]
      split("used capacity available",names," ")
      for(i=1;i<=3;i++) { mk=k SUBSEP "kubelet_volume_stats_" names[i] "_bytes"; printf "\t%s\t%s\t%s",(mk in seen ? sprintf("%.0f",V[mk]) : "?"),(mk in seen ? sprintf("%.0f",T[mk]) : "?"),(mk in seen ? O[mk] : "?") }
      printf "\n"
    } }
  ' "$out" > "$TOOLKIT_DIR/health-volume-usage.tsv"
  if [ -s "$TOOLKIT_DIR/health-volume-usage.tsv" ]; then
    health__status volume-metrics ok 'kubelet PVC samples from Prometheus; duplicate scrape series use latest/max, never sum'
  else health__status volume-metrics no-data 'source answered without usable PVC samples in scope; measured usage unknown'; fi
}

health_collect() {
  [ -n "${TOOLKIT_DIR:-}" ] || return 1
  mkdir -p "$TOOLKIT_DIR" || return 1
  health__read services services yes '{{range .items}}{{$o := .}}S|{{.metadata.namespace}}|{{.metadata.name}}|{{.spec.type}}|{{.spec.externalName}}|{{.spec.clusterIP}}|{{range $k,$v := .spec.selector}}{{$k}}={{$v}},{{end}}{{"\n"}}{{range .spec.ports}}T|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{.name}}|{{.port}}|{{.targetPort}}|{{.protocol}}{{"\n"}}{{end}}{{end}}'
  health__read pods pods yes '{{range .items}}{{$o := .}}P|{{.metadata.namespace}}|{{.metadata.name}}|{{.status.phase}}|{{range .status.conditions}}{{if eq .type "Ready"}}{{.status}}{{end}}{{end}}|{{range $k,$v := .metadata.labels}}{{$k}}={{$v}},{{end}}|{{.status.podIP}}|{{.metadata.deletionTimestamp}}{{"\n"}}{{range .spec.volumes}}{{if .persistentVolumeClaim}}V|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{.name}}|{{.persistentVolumeClaim.claimName}}{{"\n"}}{{end}}{{end}}{{range .spec.containers}}{{$c := .}}{{range .ports}}C|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{$c.name}}|{{.name}}|{{.containerPort}}|{{.protocol}}{{"\n"}}{{end}}{{range .volumeMounts}}M|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{$c.name}}|{{.name}}|{{.mountPath}}|{{.readOnly}}{{"\n"}}{{end}}{{end}}{{range .spec.initContainers}}{{$c := .}}{{range .volumeMounts}}M|{{$o.metadata.namespace}}|{{$o.metadata.name}}|init:{{$c.name}}|{{.name}}|{{.mountPath}}|{{.readOnly}}{{"\n"}}{{end}}{{end}}{{end}}'
  health__read endpoints endpointslices.discovery.k8s.io yes '{{range .items}}{{$o := .}}{{$s := index .metadata.labels "kubernetes.io/service-name"}}E|{{.metadata.namespace}}|{{$s}}|{{.metadata.name}}|{{.addressType}}{{"\n"}}{{range .ports}}B|{{$o.metadata.namespace}}|{{$s}}|{{$o.metadata.name}}|{{.name}}|{{.port}}|{{.protocol}}{{"\n"}}{{end}}{{range .endpoints}}D|{{$o.metadata.namespace}}|{{$s}}|{{$o.metadata.name}}|{{.targetRef.namespace}}|{{.targetRef.name}}|{{.targetRef.kind}}|{{.conditions.ready}}|{{.conditions.serving}}|{{.conditions.terminating}}|{{range .addresses}}{{.}},{{end}}{{"\n"}}{{end}}{{end}}'
  health__read ingresses ingresses.networking.k8s.io yes '{{range .items}}{{$o := .}}{{range .spec.rules}}{{$host := .host}}{{range .http.paths}}{{if .backend.service}}I|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{$o.spec.ingressClassName}}|{{$host}}|{{.path}}|{{.backend.service.name}}|{{if .backend.service.port.name}}{{.backend.service.port.name}}{{else}}{{.backend.service.port.number}}{{end}}{{"\n"}}{{end}}{{end}}{{end}}{{with .spec.defaultBackend}}{{with .service}}I|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{$o.spec.ingressClassName}}|*|default|{{.name}}|{{if .port.name}}{{.port.name}}{{else}}{{.port.number}}{{end}}{{"\n"}}{{end}}{{end}}{{end}}'
  health__read pvcs persistentvolumeclaims yes '{{range .items}}{{$o := .}}Q|{{.metadata.namespace}}|{{.metadata.name}}|{{.status.phase}}|{{.spec.volumeName}}|{{.spec.storageClassName}}|{{.spec.resources.requests.storage}}|{{.status.capacity.storage}}|{{range .spec.accessModes}}{{.}},{{end}}|{{.spec.volumeMode}}{{"\n"}}{{range .status.conditions}}F|{{$o.metadata.namespace}}|{{$o.metadata.name}}|{{.type}}|{{.status}}|{{.reason}}{{"\n"}}{{end}}{{end}}'
  health__read pvs persistentvolumes no '{{range .items}}Z|{{.metadata.name}}|{{.status.phase}}|{{.spec.storageClassName}}|{{.spec.capacity.storage}}|{{.spec.persistentVolumeReclaimPolicy}}|{{.spec.claimRef.namespace}}|{{.spec.claimRef.name}}|{{with .spec.csi}}{{.driver}}{{end}}{{"\n"}}{{end}}'
  health__read storageclasses storageclasses.storage.k8s.io no '{{range .items}}K|{{.metadata.name}}|{{.provisioner}}|{{.volumeBindingMode}}|{{.allowVolumeExpansion}}|{{.reclaimPolicy}}{{"\n"}}{{end}}'
  health__volume_metrics
  return 0
}

health__sources() {
  local source state epoch detail now stamp
  now=$(date +%s)
  for source in "$@"; do
    state=unknown; epoch=''; detail='not collected'
    if [ -r "$TOOLKIT_DIR/health-$source.status" ]; then
      IFS=$'\t' read -r state epoch detail < "$TOOLKIT_DIR/health-$source.status"
    elif [ -n "${TOOLKIT_PID:-}" ]; then
      # the first background read is still running: say so instead of "not collected"
      state=collecting; detail='first read in progress; values appear when it completes'
    fi
    case "$epoch" in ''|*[!0-9]*) stamp='time unknown' ;;
      *) stamp="$(date -d "@$epoch" '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null || printf '%s' "$epoch") ($((now-epoch))s ago)" ;;
    esac
    printf '  %s: %s; %s; %s\n' "$source" "${state:-unknown}" "$stamp" "${detail:-not collected}"
  done
}

health_render_services() {
  printf 'SERVICES AND BACKENDS\n'
  printf 'Observed Kubernetes configuration and readiness; this does not test end-to-end reachability.\n'
  health__sources services pods endpoints ingresses
  local source
  for source in services pods endpoints ingresses; do
    [ -f "$TOOLKIT_DIR/health-$source.raw" ] || : > "$TOOLKIT_DIR/health-$source.raw"
  done
  awk -F'|' -v sf="$TOOLKIT_DIR/health-services.raw" -v pf="$TOOLKIT_DIR/health-pods.raw" \
    -v ef="$TOOLKIT_DIR/health-endpoints.raw" -v inf="$TOOLKIT_DIR/health-ingresses.raw" \
    -v ss="$(health__state services)" -v ps="$(health__state pods)" \
    -v es="$(health__state endpoints)" -v ins="$(health__state ingresses)" '
    function clean(s) { return (s=="<no value>" || s=="<nil>" || s=="null") ? "" : s }
    function matches(sel, labels,   a,n,i) {
      n=split(sel,a,","); for(i=1;i<=n;i++) if(a[i]!="" && !index("," labels,"," a[i] ",")) return 0
      return 1
    }
    function proto(s) { return s=="" ? "TCP" : s }
    function nocomma(s) { sub(/,$/,"",s); return s }
    function endpoints(k) { return es=="ok" ? (ER[k]+0) " ready / " (EB[k]+0) " unready / " (EU[k]+0) " unknown" : "unknown" }
    FILENAME==sf && $1=="S" { k=$2 SUBSEP $3; if(!(k in SN)) SK[++NS]=k; SN[k]=$2 "/" $3; ST[k]=clean($4); EXT[k]=clean($5); IP[k]=clean($6); SEL[k]=nocomma(clean($7)); next }
    FILENAME==sf && $1=="T" { k=$2 SUBSEP $3; n=++NT[k]; TN[k,n]=clean($4); TP[k,n]=clean($5); TT[k,n]=clean($6); PT[k,n]=proto(clean($7)); next }
    FILENAME==pf && $1=="P" { k=$2 SUBSEP $3; PK[++NP]=k; PN[k]=$2 "/" $3; PNS[k]=$2; READY[k]=$5; LABELS[k]=$6; DEL[k]=clean($8); next }
    FILENAME==pf && $1=="C" && clean($5)!="" { PORT[$2 SUBSEP $3 SUBSEP $5 SUBSEP proto(clean($7))]=1; next }
    FILENAME==ef && $1=="E" { k=$2 SUBSEP $3; EC[k]++; next }
    FILENAME==ef && $1=="D" {
      k=$2 SUBSEP $3; if($8=="true") ER[k]++; else if($8=="false") EB[k]++; else EU[k]++
      if($7=="Pod") { ns=clean($5); if(ns=="") ns=$2; p=ns SUBSEP clean($6); EK[k,p]=1; if($8=="true" && $10!="true") EPR[k,p]=1 }
      next
    }
    FILENAME==inf && $1=="I" { IR[++NI]=$0; next }
    END {
      for(si=1;si<=NS;si++) {
        k=SK[si]; split(k,z,SUBSEP)
        if(SEL[k]!="" && ST[k]!="ExternalName" && ps=="ok") for(pi=1;pi<=NP;pi++) {
          p=PK[pi]; if(PNS[p]!=z[1] || !matches(SEL[k],LABELS[p])) continue
          MATCH[k,p]=1; SELECTED[k]++; if(READY[p]=="True" && DEL[p]=="") { PR[k]++; if(PR[k]<=3) PLIST[k]=PLIST[k] (PLIST[k]=="" ? "" : ", ") PN[p] }
          for(ti=1;ti<=NT[k];ti++) if(TT[k,ti]!="" && TT[k,ti]!~/^[0-9]+$/ && !((p SUBSEP TT[k,ti] SUBSEP PT[k,ti]) in PORT)) MISSING[k,ti]++
        }
      }
      print "\nINGRESS -> SERVICE -> ENDPOINTS -> READY PODS"
      if(ins!="ok") print "  Ingress routes unknown: optional source " ins "."
      else if(NI==0) print "  No service-backed Ingress routes in this collected scope (resource backends are not expanded)."
      else for(i=1;i<=NI;i++) {
        split(IR[i],r,"|"); k=r[2] SUBSEP r[7]; host=clean(r[5]); if(host=="") host="*"
        printf "  %s/%s  %s%s -> %s/%s:%s\n",r[2],r[3],host,r[6],r[2],r[7],r[8]
        if(ss!="ok") { print "    Service and backend relationship unknown: services source " ss "."; continue }
        if(!(k in SN)) { print "    Service missing from the successful service read."; continue }
        found=0; for(j=1;j<=NT[k];j++) if(r[8]==TN[k,j] || r[8]==TP[k,j]) found=1
        if(!found) print "    Ingress backend port does not match a Service port."
        if(ST[k]=="ExternalName") print "    ExternalName DNS alias -> " EXT[k] "; pod backend readiness is not inferred."
        else printf "    %s slices; endpoints %s; ready selected pods %s\n",(es=="ok" ? EC[k]+0 : "unknown"),endpoints(k),(ps=="ok" && SEL[k]!="" ? PR[k]+0 : "unknown")
      }
      print "\nSERVICE BACKEND DIAGNOSTICS"
      printf "  %-36s %-13s %-10s %-10s %s\n","NAMESPACE/SERVICE","TYPE","SELECTED","READY PODS","ENDPOINT READINESS"
      if(ss!="ok") { print "  Service inventory unknown: source " ss "."; exit }
      if(NS==0) print "  No Services in this successful scoped read."
      for(si=1;si<=NS;si++) {
        k=SK[si]; selected=(ps=="ok" && SEL[k]!="" && ST[k]!="ExternalName")
        printf "  %-36s %-13s %-10s %-10s %s\n",SN[k],ST[k],(selected ? SELECTED[k]+0 : "unknown"),(selected ? PR[k]+0 : "unknown"),endpoints(k)
        if(ST[k]=="ExternalName") { print "    DNS alias -> " EXT[k] "; selectors and EndpointSlices are not required for this Service type."; continue }
        if(SEL[k]=="") print "    Selectorless Service: backends can be managed manually; no selector mismatch is inferred."
        else {
          print "    selector: " SEL[k]
          if(ps!="ok") print "    Pod selection and named target ports unknown: pods source " ps "."
          else if(SELECTED[k]==0) print "    SELECTOR MISMATCH: selector matches no pods in this collected scope."
          else if(PR[k]==0) print "    UNREADY: selected pods exist, but none are Ready and non-terminating."
          else print "    Ready selected pods: " PLIST[k] (PR[k]>3 ? " (+" (PR[k]-3) " more)" : "")
        }
        for(ti=1;ti<=NT[k];ti++) {
          printf "    port %s%s/%s -> targetPort %s\n",(TN[k,ti]!="" ? TN[k,ti] ":" : ""),TP[k,ti],PT[k,ti],(TT[k,ti]!="" ? TT[k,ti] : TP[k,ti])
          if(selected && MISSING[k,ti]>0) printf "    NAMED PORT MISSING: %s/%s absent on %d/%d selected pods.\n",TT[k,ti],PT[k,ti],MISSING[k,ti],SELECTED[k]
        }
        if(es=="ok") {
          if(EC[k]==0) print "    No EndpointSlices for this Service in the successful slice read."
          else if(ER[k]==0) print "    No explicitly ready endpoints observed; unknown readiness remains unknown."
          linked=0; readyLinked=0
          for(ep in EK) { split(ep,pp,SUBSEP); if(pp[1] SUBSEP pp[2]!=k) continue; p=pp[3] SUBSEP pp[4]; linked++; if(EPR[k,p] && READY[p]=="True" && DEL[p]=="") readyLinked++ }
          if(linked>0 && ps=="ok") printf "    EndpointSlice Pod references: %d unique; explicitly ready endpoints pointing to Ready pods: %d.\n",linked,readyLinked
        } else print "    EndpointSlice backend state unknown: source " es "."
        if(IP[k]=="None") print "    Headless Service: DNS/backend records apply; there is no virtual ClusterIP."
      }
      print "\nReadiness is an API observation. DNS, ingress controllers, NetworkPolicy, routing, TLS and application responses are not tested."
    }
  ' "$TOOLKIT_DIR/health-services.raw" "$TOOLKIT_DIR/health-pods.raw" "$TOOLKIT_DIR/health-endpoints.raw" "$TOOLKIT_DIR/health-ingresses.raw"
}

health__storage_events() {
  local file=''
  if [ -r "$TOOLKIT_DIR/events.tsv" ]; then file="$TOOLKIT_DIR/events.tsv"
  elif [ -n "${MODEL:-}" ] && [ -r "$MODEL/events.tsv" ]; then file="$MODEL/events.tsv"; fi
  printf '\nSTORAGE-RELATED RECORDED EVENTS\n'
  if [ -z "$file" ]; then
    printf '  Event data is unavailable in this snapshot; inspect the Events view for mount, attach and provisioning failures.\n'
    return 0
  fi
  awk -F'\t' '
    NR==1 { header=$0; if(tolower($0) ~ /message|reason/) { next } }
    tolower($0) ~ /failedmount|failedattach|failedbinding|failedprovision|provisioningfailed|volume|persistentvolumeclaim|storageclass|claim/ {
      if(n++==0 && header!="") print "  " header
      if(n<=12) print "  " $0
    }
    END { if(n==0) print "  No matching storage entries in the available event file; scope and collection window apply."
      else if(n>12) print "  Additional matching events are available in the Events view." }
  ' "$file"
}

health_render_storage() {
  printf 'PERSISTENT STORAGE\n'
  printf 'PVC/PV capacity describes allocation; measured usage is shown only when PVC-labelled volume samples exist.\n'
  health__sources pvcs pods pvs storageclasses volume-metrics
  local source
  for source in pvcs pods pvs storageclasses; do
    [ -f "$TOOLKIT_DIR/health-$source.raw" ] || : > "$TOOLKIT_DIR/health-$source.raw"
  done
  [ -f "$TOOLKIT_DIR/health-volume-usage.tsv" ] || : > "$TOOLKIT_DIR/health-volume-usage.tsv"
  awk -F'|' -v qf="$TOOLKIT_DIR/health-pvcs.raw" -v pf="$TOOLKIT_DIR/health-pods.raw" \
    -v vf="$TOOLKIT_DIR/health-pvs.raw" -v cf="$TOOLKIT_DIR/health-storageclasses.raw" \
    -v uf="$TOOLKIT_DIR/health-volume-usage.tsv" -v qs="$(health__state pvcs)" \
    -v ps="$(health__state pods)" -v vs="$(health__state pvs)" \
    -v cs="$(health__state storageclasses)" -v us="$(health__state volume-metrics)" -v now="$(date +%s)" '
    function clean(s) { return (s=="<no value>" || s=="<nil>" || s=="null") ? "" : s }
    function known(s) { return clean(s)=="" ? "unknown" : s }
    function nocomma(s) { sub(/,$/,"",s); return s }
    function bytes(s,   n,i,a) {
      if(s=="?" || s=="") return "unknown"; n=s+0; split("B KiB MiB GiB TiB PiB",a," "); i=1
      while(n>=1024 && i<6) { n/=1024; i++ } return sprintf("%.1f%s",n,a[i])
    }
    function sample(ts,origin,   age) {
      if(ts=="?" || ts=="") return "unknown"; age=now-ts; if(age<0) return "clock ahead"
      return sprintf("%ds ago (%s time)%s",age,origin,(age>300 ? " STALE" : ""))
    }
    FILENAME==qf && $1=="Q" { k=$2 SUBSEP $3; QK[++NQ]=k; QN[k]=$2 "/" $3; QPH[k]=clean($4); QPV[k]=clean($5); QC[k]=clean($6); QR[k]=clean($7); QCAP[k]=clean($8); QA[k]=nocomma(clean($9)); QM[k]=clean($10); next }
    FILENAME==qf && $1=="F" && $5=="True" { k=$2 SUBSEP $3; COND[k]=COND[k] " " $4 ":" clean($6); next }
    FILENAME==pf && $1=="P" { k=$2 SUBSEP $3; PP[k]=$4 "/" $5; next }
    FILENAME==pf && $1=="V" { p=$2 SUBSEP $3; k=$2 SUBSEP $5; VCLAIM[p,$4]=k; REF[k,p]=1; next }
    FILENAME==pf && $1=="M" { p=$2 SUBSEP $3; MK[++NM]=p SUBSEP $5; MC[NM]=$4; MP[NM]=$6; MRO[NM]=$7; next }
    FILENAME==vf && $1=="Z" { PV[$2]=1; VPH[$2]=clean($3); VC[$2]=clean($4); VCAP[$2]=clean($5); VR[$2]=clean($6); VCLAIM[$2]=clean($7) "/" clean($8); DRIVER[$2]=clean($9); next }
    FILENAME==cf && $1=="K" { SC[$2]=1; PROV[$2]=clean($3); BIND[$2]=clean($4); EXPAND[$2]=clean($5); RECLAIM[$2]=clean($6); next }
    FILENAME==uf {
      split($0,u,"\t"); k=u[1] SUBSEP u[2]; USED[k]=u[3]; UT[k]=u[4]; UO[k]=u[5]; CAP[k]=u[6]; CT[k]=u[7]; CO[k]=u[8]; AVAIL[k]=u[9]; AT[k]=u[10]; AO[k]=u[11]; next
    }
    END {
      print "\nPVC BINDINGS AND POD REFERENCES"
      printf "  %-34s %-10s %-20s %-13s %-13s %s\n","NAMESPACE/CLAIM","PHASE","PV","REQUEST","PVC CAPACITY","STORAGECLASS"
      if(qs!="ok") print "  PVC inventory and binding completeness unknown: source " qs "."
      else if(NQ==0) print "  No PVCs in this successful scoped read."
      if(qs=="ok") for(i=1;i<=NQ;i++) {
        k=QK[i]; v=QPV[k]; c=QC[k]
        printf "  %-34s %-10s %-20s %-13s %-13s %s\n",QN[k],known(QPH[k]),(v!="" ? v : "unbound"),known(QR[k]),known(QCAP[k]),(c!="" ? c : "unspecified")
        printf "    access=%s; volumeMode=%s\n",known(QA[k]),known(QM[k])
        if(COND[k]!="") print "    PVC conditions:" COND[k]
        if(v!="") {
          if(vs!="ok") print "    PV details unknown: optional source " vs "."
          else if(!(v in PV)) print "    BINDING CHECK: referenced PV missing from the successful PV read."
          else {
            printf "    PV phase=%s; capacity=%s; reclaim=%s; driver=%s\n",known(VPH[v]),known(VCAP[v]),known(VR[v]),known(DRIVER[v])
            if(VCLAIM[v]!="/" && VCLAIM[v]!=QN[k]) print "    BINDING CHECK: PV claimRef points to " VCLAIM[v] ", not " QN[k] "."
          }
        }
        if(c!="") {
          if(cs!="ok") print "    StorageClass details unknown: optional source " cs "."
          else if(!(c in SC)) print "    StorageClass missing from the successful class read."
          else {
            printf "    StorageClass provisioner=%s; binding=%s; expansion=%s\n",known(PROV[c]),known(BIND[c]),known(EXPAND[c])
            if(QPH[k]=="Pending" && BIND[c]=="WaitForFirstConsumer") print "    Pending claim uses WaitForFirstConsumer; scheduling/consumer placement may be required before binding."
          }
        }
        refs=0
        if(ps!="ok") print "    Pod volume references and mounts unknown: pods source " ps "."
        else {
          for(r in REF) { split(r,a,SUBSEP); if(a[1] SUBSEP a[2]!=k) continue; p=a[3] SUBSEP a[4]; refs++
            printf "    pod reference: %s/%s (%s)\n",a[3],a[4],known(PP[p])
          }
          if(refs==0) print "    No pod volume references in this collected scope; this does not establish that storage is unused."
          for(m=1;m<=NM;m++) if(VCLAIM[MK[m]]==k) {
            split(MK[m],a,SUBSEP); printf "    declared mount: %s/%s container=%s path=%s readOnly=%s\n",a[1],a[2],MC[m],MP[m],(MRO[m]=="true" ? "true" : "false")
          }
        }
        if(us=="ok" && (k in USED)) {
          printf "    measured used=%s; measured filesystem capacity=%s; available=%s",bytes(USED[k]),bytes(CAP[k]),bytes(AVAIL[k])
          skew=UT[k]-CT[k]; if(skew<0) skew=-skew
          if(USED[k]!="?" && CAP[k]!="?" && CAP[k]+0>0 && skew<=300) printf "; used/capacity=%.1f%%",100*USED[k]/CAP[k]
          else if(USED[k]!="?" && CAP[k]!="?" && skew>300) printf "; percentage unknown (sample times differ by more than 5m)"
          printf "\n    usage sample: %s; capacity sample: %s; available sample: %s\n",sample(UT[k],UO[k]),sample(CT[k],CO[k]),sample(AT[k],AO[k])
        } else print "    Measured usage unknown: no usable PVC-labelled volume sample for this claim."
      }
      if(ps=="ok" && qs=="ok") for(r in REF) {
        split(r,a,SUBSEP); k=a[1] SUBSEP a[2]
        if(!(k in QN)) printf "  MISSING PVC REFERENCE: pod %s/%s refers to %s/%s, absent from the successful scoped PVC read.\n",a[3],a[4],a[1],a[2]
      }
      print "\nPod volume references and declared mount paths do not prove a volume mounted successfully."
      print "Measured filesystem samples can differ from PVC/PV allocation; missing samples never mean zero usage."
    }
  ' "$TOOLKIT_DIR/health-pvcs.raw" "$TOOLKIT_DIR/health-pods.raw" "$TOOLKIT_DIR/health-pvs.raw" "$TOOLKIT_DIR/health-storageclasses.raw" "$TOOLKIT_DIR/health-volume-usage.tsv"
  health__storage_events
}

# Interactive, read-only pod inspection. This source is embedded in the release
# executable; all API reads use the audited, context-pinned KC argv array.
# Logs live only in TMPD/inspector and never enter MODEL or report/session files.

inspector_clean() {
  # Preserve UTF-8, tabs and line endings, but remove terminal control bytes.
  LC_ALL=C tr -d '\000-\010\013-\037\177'
}

inspector_identity_ok() {
  [[ "${1:-}" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] &&
    [[ "${2:-}" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] &&
    [ "${#1}" -le 63 ] && [ "${#2}" -le 253 ]
}

inspector_limits() {
  INSPECTOR_TAIL="${KDASH_LOG_TAIL:-200}"
  INSPECTOR_BYTES="${KDASH_LOG_LIMIT_BYTES:-65536}"
  case "$INSPECTOR_TAIL" in ''|*[!0-9]*) INSPECTOR_TAIL=200 ;; esac
  case "$INSPECTOR_BYTES" in ''|*[!0-9]*) INSPECTOR_BYTES=65536 ;; esac
  [ "${#INSPECTOR_TAIL}" -gt 4 ] && INSPECTOR_TAIL=2000
  [ "${#INSPECTOR_BYTES}" -gt 7 ] && INSPECTOR_BYTES=1048576
  INSPECTOR_TAIL=$((10#$INSPECTOR_TAIL)); INSPECTOR_BYTES=$((10#$INSPECTOR_BYTES))
  [ "$INSPECTOR_TAIL" -lt 1 ] && INSPECTOR_TAIL=1
  [ "$INSPECTOR_TAIL" -gt 2000 ] && INSPECTOR_TAIL=2000
  [ "$INSPECTOR_BYTES" -lt 1024 ] && INSPECTOR_BYTES=1024
  [ "$INSPECTOR_BYTES" -gt 1048576 ] && INSPECTOR_BYTES=1048576
  # f follows a log pane: reload it every KDASH_INSPECT_FOLLOW seconds (1..60).
  INSPECTOR_FOLLOW_SECS="${KDASH_INSPECT_FOLLOW:-5}"
  case "$INSPECTOR_FOLLOW_SECS" in ''|*[!0-9]*) INSPECTOR_FOLLOW_SECS=5 ;; esac
  [ "$INSPECTOR_FOLLOW_SECS" -lt 1 ] && INSPECTOR_FOLLOW_SECS=1
  [ "$INSPECTOR_FOLLOW_SECS" -gt 60 ] && INSPECTOR_FOLLOW_SECS=60
  return 0
}

inspector_query() { # output-file kubectl-args...; bounded text, preserved rc
  local dest="$1" rc=0 cap="${INSPECTOR_QUERY_CAP:-262144}" reader; shift
  "${KC[@]}" "$@" > "$dest.raw" 2> "$dest.err" & reader=$!
  wait "$reader" || rc=$?
  { head -c "$cap" "$dest.raw"; } | inspector_clean > "$dest"
  if [ "$rc" != 0 ]; then
    printf '\nRead failed (exit %s). Verify the namespace, pod and your RBAC permissions.\n' "$rc" >> "$dest"
    head -c 4096 "$dest.err" | inspector_clean >> "$dest"
  fi
  if [ "$(wc -c < "$dest.raw")" -gt "$cap" ]; then
    printf '\n[Output clipped at %s bytes.]\n' "$cap" >> "$dest"
  fi
  rm -f -- "$dest.raw" "$dest.err"
  return "$rc"
}

inspector_containers() { # ns pod -> TYPE<TAB>NAME<TAB>IMAGE (including init/debug)
  "${KC[@]}" get pod "$2" -n "$1" -o 'jsonpath={range .spec.containers[*]}regular{"\t"}{.name}{"\t"}{.image}{"\n"}{end}{range .spec.initContainers[*]}init{"\t"}{.name}{"\t"}{.image}{"\n"}{end}{range .spec.ephemeralContainers[*]}debug{"\t"}{.name}{"\t"}{.image}{"\n"}{end}' |
    inspector_clean
}

inspector_summary() { # ns pod output-file
  inspector_query "$3" get pod "$2" -n "$1" -o 'jsonpath=Name: {.metadata.name}{"\n"}Namespace: {.metadata.namespace}{"\n"}UID: {.metadata.uid}{"\n"}Created: {.metadata.creationTimestamp}{"\n"}Phase: {.status.phase}{"\n"}Reason: {.status.reason}{"\n"}Message: {.status.message}{"\n"}Node: {.spec.nodeName}{"\n"}Pod IP: {.status.podIP}{"\n"}Service account: {.spec.serviceAccountName}{"\n"}{range .metadata.ownerReferences[*]}Owner: {.kind}/{.name}{"\n"}{end}{"\nCONDITIONS\n"}{range .status.conditions[*]}{.type}{"\t"}{.status}{"\t"}{.reason}{"\t"}{.message}{"\n"}{end}{"\nCONTAINERS (requests / limits)\n"}{range .spec.containers[*]}{.name}{"\t"}{.image}{"\n"}  CPU: {.resources.requests.cpu} / {.resources.limits.cpu}{"\t"}Memory: {.resources.requests.memory} / {.resources.limits.memory}{"\n"}{end}{"\nCONTAINER STATUS\n"}{range .status.containerStatuses[*]}{.name}{"\tready="}{.ready}{"\trestarts="}{.restartCount}{"\n"}  Waiting: {.state.waiting.reason} {.state.waiting.message}{"\n"}  Running since: {.state.running.startedAt}{"\n"}  Terminated: {.state.terminated.reason} exit={.state.terminated.exitCode}{"\n"}  Previous: {.lastState.terminated.reason} exit={.lastState.terminated.exitCode}{"\n"}{end}{"\nINIT CONTAINER STATUS\n"}{range .status.initContainerStatuses[*]}{.name}{"\tready="}{.ready}{"\trestarts="}{.restartCount}{"\t"}{.state.waiting.reason}{.state.terminated.reason}{"\n"}{end}'
}

inspector_logs() { # ns pod container current|previous output-file
  local ns="$1" pod="$2" container="$3" mode="$4" dest="$5" rc=0
  local flags=()
  case "$mode" in current) ;; previous) flags+=(--previous) ;; *) printf 'Invalid log mode: current or previous required.\n' > "$dest"; return 2 ;; esac
  [[ "$container" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || {
    printf 'Choose a valid container before reading logs.\n' > "$dest"; return 2;
  }
  inspector_limits
  printf 'Container: %s | %s logs | last %s lines | maximum %s bytes | timestamps\n\n' "$container" "$mode" "$INSPECTOR_TAIL" "$INSPECTOR_BYTES" > "$dest"
  INSPECTOR_QUERY_CAP="$INSPECTOR_BYTES" inspector_query "$dest.body" logs "$pod" -n "$ns" -c "$container" \
    --tail="$INSPECTOR_TAIL" --limit-bytes="$INSPECTOR_BYTES" --timestamps=true "${flags[@]}" || rc=$?
  cat "$dest.body" >> "$dest"; rm -f -- "$dest.body"
  [ "$mode" != previous ] || [ "$rc" = 0 ] || printf '\nPrevious logs require a previously terminated instance of this container.\n' >> "$dest"
  return "$rc"
}

inspector_events() { # ns pod output-file
  if declare -F events_render >/dev/null; then
    events_render "$1" "$2" | inspector_clean > "$3"
  else
    inspector_query "$3" get events -n "$1" --field-selector="involvedObject.kind=Pod,involvedObject.name=$2" \
      --sort-by=.metadata.creationTimestamp -o wide
  fi
}

inspector_explain() { # ns pod output-file
  if declare -F explain_render >/dev/null; then
    explain_render "$1" "$2" | inspector_clean > "$3"
  else
    printf 'Failure explanations are unavailable. Inspect conditions, Events and previous logs for evidence.\n' > "$3"
  fi
}

inspector_render() { # ns pod: plain bounded CLI output; logs require explicit opt-in
  local ns="${1:-${NS:-default}}" pod="${2:-}" d container="${KDASH_INSPECT_CONTAINER:-}" rc=0 mode="${KDASH_INSPECT_LOGS:-}"
  inspector_identity_ok "$ns" "$pod" || { printf 'kdash: inspect requires a valid namespace and pod name.\n' >&2; return 2; }
  d="${TMPD:?}/inspector/cli"; (umask 077; mkdir -p "$d") || return 1
  printf 'Context: %s | Namespace: %s | Pod: %s\n\n' "${CTX_NAME:-${CTX:-current}}" "$ns" "$pod" | inspector_clean
  if [ -n "$mode" ]; then
    if [ -z "$container" ]; then
      if ! inspector_containers "$ns" "$pod" > "$d/containers" 2> "$d/container.err"; then
        printf 'Cannot discover containers.\n' >&2
        head -c 4096 "$d/container.err" | inspector_clean >&2
        rm -rf -- "$d"; return 1
      fi
      container="$(awk -F '\t' 'NF >= 2 {print $2; exit}' "$d/containers")"
    fi
    inspector_logs "$ns" "$pod" "$container" "$mode" "$d/output" || rc=$?
  else
    inspector_summary "$ns" "$pod" "$d/output" || rc=$?
  fi
  cat "$d/output"
  rm -rf -- "$d"
  return "$rc"
}

inspector_model_rows() { # MODEL has already applied the dashboard/API filters
  [ -r "${MODEL:?}/pods.tsv" ] || return 0
  awk -F '\t' '
    NR > 1 {printf "%s\t%s\t%s\t%s\t%s\t%s\n", $2, $3, $4, $5, $6, $7}
  ' "$MODEL/pods.tsv" | inspector_clean
}

inspector_size() {
  INSPECTOR_ROWS="${KDASH_LINES:-${LINES:-24}}"; INSPECTOR_COLS="${KDASH_COLUMNS:-${COLUMNS:-100}}"
  if command -v tput >/dev/null 2>&1; then
    [ -n "${KDASH_LINES:-}" ] || INSPECTOR_ROWS="$(tput lines 2>/dev/null || printf 24)"
    [ -n "${KDASH_COLUMNS:-}" ] || INSPECTOR_COLS="$(tput cols 2>/dev/null || printf 100)"
  fi
  case "$INSPECTOR_ROWS" in ''|*[!0-9]*) INSPECTOR_ROWS=24 ;; esac
  case "$INSPECTOR_COLS" in ''|*[!0-9]*) INSPECTOR_COLS=100 ;; esac
  [ "$INSPECTOR_ROWS" -ge 12 ] || INSPECTOR_ROWS=12
  [ "$INSPECTOR_COLS" -ge 40 ] || INSPECTOR_COLS=40
  return 0
}

# Escape sequences: arrows, PgUp/PgDn, Home/End. Decoded after a short pause so
# a bare Esc still means "back".
inspector_decode_escape() {
  local seq="" extra=""
  IFS= read -rsn2 -t 0.05 seq </dev/tty || true
  case "$seq" in
    '[A') INSPECTOR_KEY=k ;; '[B') INSPECTOR_KEY=j ;;
    '[C') INSPECTOR_KEY=l ;; '[D') INSPECTOR_KEY=b ;;
    '[H') INSPECTOR_KEY=g ;; '[F') INSPECTOR_KEY=G ;;
    '[5'|'[6'|'[1'|'[4')
      IFS= read -rsn1 -t 0.05 extra </dev/tty || true
      case "$seq$extra" in '[5~') INSPECTOR_KEY=b ;; '[6~') INSPECTOR_KEY=' ' ;; '[1~') INSPECTOR_KEY=g ;; '[4~') INSPECTOR_KEY=G ;; esac ;;
  esac
}

# Blocking without an argument; with a timeout it returns 1 when no key arrived
# (follow mode uses that to reload the pane).
inspector_key() {
  local t="${1:-}"
  INSPECTOR_KEY=""
  if [ -n "$t" ]; then
    IFS= read -rsn1 -t "$t" INSPECTOR_KEY </dev/tty || { INSPECTOR_KEY=""; return 1; }
  else
    IFS= read -rsn1 INSPECTOR_KEY </dev/tty || return 1
  fi
  [ "$INSPECTOR_KEY" != $'\033' ] || inspector_decode_escape
  return 0
}

#---- search, log level, filtering and highlighting (all local, never the API) --------
INSPECTOR_SEARCH="${INSPECTOR_SEARCH:-}"
INSPECTOR_ONLY="${INSPECTOR_ONLY:-0}"     # 1 = the view keeps only matching lines (key &)
INSPECTOR_LEVEL_NAME="${INSPECTOR_LEVEL_NAME:-all}"
INSPECTOR_LEVEL_PAT="${INSPECTOR_LEVEL_PAT:-}"

# A lowercase pattern without regex metacharacters matches case-insensitively, which is
# what an operator typing "error" means; anything else is used exactly as written.
inspector_icase() {
  case "$1" in
    *[A-Z]*) printf 0 ;;
    *"["*|*"]"*|*"("*|*")"*|*"|"*|*"+"*|*"*"*|*"?"*|*"{"*|*"}"*|*"^"*|*"$"*|*"."*|*"\\"*) printf 0 ;;
    *) printf 1 ;;
  esac
}

inspector_pattern_ok() {  # valid extended regular expression, no control bytes
  local p="$1" rc=0
  [ "${#p}" -le 200 ] || return 1
  [[ "$p" != *[$'\001'-$'\037'$'\177']* ]] || return 1
  printf '' | grep -E -- "$p" >/dev/null 2>&1 || rc=$?
  [ "$rc" != 2 ]
}

inspector_search_prompt() {  # pane name [only]; sets INSPECTOR_SEARCH and INSPECTOR_ONLY
  local line="" msg="" pane="$1" mode="${2:-find}"
  while :; do
    printf '\033[H\033[2J %s in the %s pane | Pod: %s | Container: %s\n\n' \
      "$([ "$mode" = only ] && printf 'Show only matching lines' || printf 'Find')" "$pane" "${POD_PICK:-}" "${KDASH_INSPECT_CONTAINER:-all}"
    printf ' Extended regular expression. A lowercase pattern ignores case.\n Examples: error   OOMKilled   FailedMount|MountVolume  127.0.0.1  ^2026-10-29T1\n\n'
    printf ' %s\n' "$([ "$mode" = only ] && printf 'The pane will show only the lines that match (press / for context again).' || printf 'Every line stays visible: matches are highlighted, n and N jump between them.')"
    printf ' Empty Enter clears the search; q cancels; Enter applies what you typed.\n Current: %s%s\n%s\n\033[?25h %s ' \
      "${INSPECTOR_SEARCH:-none}" "$([ "${INSPECTOR_ONLY:-0}" = 1 ] && printf ' (only matches)' || printf '')" "$msg" \
      "$([ "$mode" = only ] && printf '&' || printf '/')"
    IFS= read -r line </dev/tty || { printf '\033[?25l'; return 1; }
    printf '\033[?25l'
    case "$line" in q|Q) return 1 ;; esac
    if [ -z "$line" ]; then INSPECTOR_SEARCH=""; INSPECTOR_ONLY=0; return 0; fi
    if inspector_pattern_ok "$line"; then
      INSPECTOR_SEARCH="$line"
      [ "$mode" = only ] && INSPECTOR_ONLY=1 || INSPECTOR_ONLY=0
      return 0
    fi
    msg=' That is not a valid regular expression - try again.'
  done
}

# Cumulative log levels, like a logging framework: ERROR hides the chatter, DEBUG keeps it.
inspector_level_cycle() {
  case "${INSPECTOR_LEVEL_NAME:-all}" in
    all)   INSPECTOR_LEVEL_NAME=ERROR; INSPECTOR_LEVEL_PAT='(^|[^A-Za-z])(ERROR|FATAL|SEVERE|Exception|exception|panic)' ;;
    ERROR) INSPECTOR_LEVEL_NAME=WARN;  INSPECTOR_LEVEL_PAT='(^|[^A-Za-z])(WARN|WARNING|ERROR|FATAL|SEVERE|Exception|exception|panic)' ;;
    WARN)  INSPECTOR_LEVEL_NAME=INFO;  INSPECTOR_LEVEL_PAT='(^|[^A-Za-z])(INFO|WARN|WARNING|ERROR|FATAL|SEVERE)' ;;
    INFO)  INSPECTOR_LEVEL_NAME=DEBUG; INSPECTOR_LEVEL_PAT='(^|[^A-Za-z])(DEBUG|TRACE|INFO|WARN|ERROR|FATAL)' ;;
    *)     INSPECTOR_LEVEL_NAME=all;   INSPECTOR_LEVEL_PAT='' ;;
  esac
}

# Build the view: level filter, then search filter, plus the line numbers of the matches
# inside that view (so n/N can jump) and the counts for the header.
inspector_view_build() { # body view matches
  local body="$1" view="$2" matchf="$3" icase=0
  [ -z "${INSPECTOR_SEARCH:-}" ] || icase="$(inspector_icase "$INSPECTOR_SEARCH")"
  awk -v pat="${INSPECTOR_SEARCH:-}" -v icase="$icase" -v lvl="${INSPECTOR_LEVEL_PAT:-}" \
      -v only="${INSPECTOR_ONLY:-0}" -v matchf="$matchf" -v metaf="$view.meta" '
    function hit(line) {
      if (pat == "") return 0
      return (icase ? (tolower(line) ~ tolower(pat)) : (line ~ pat))
    }
    { if (lvl != "" && $0 !~ lvl) next
      m = hit($0)
      if (only == "1" && pat != "" && !m) next
      n++
      print
      if (m) { hits++; print n > matchf } }
    END { printf "%d %d\n", n + 0, hits + 0 > metaf }
  ' "$body" > "$view"
  INSPECTOR_VIEW_LINES=0; INSPECTOR_MATCHES=0
  [ -r "$view.meta" ] && read -r INSPECTOR_VIEW_LINES INSPECTOR_MATCHES < "$view.meta"
  return 0
}

# Print the visible slice, clipped to the terminal width and with the matches marked.
# Clipping happens before the colour codes are added so the width stays exact.
inspector_show() { # view first last cols color
  local icase="" view="$1"
  [ -z "${INSPECTOR_SEARCH:-}" ] || icase="$(inspector_icase "$INSPECTOR_SEARCH")"
  awk -v first="$2" -v last="$3" -v w="$4" -v color="$5" \
      -v pat="${INSPECTOR_SEARCH:-}" -v icase="$icase" '
    function hl(s, p,   out, rest, hay, at, len) {
      if (p == "" || color != "1") return s
      out = ""; rest = s
      while (rest != "") {
        hay = (icase == "1") ? tolower(rest) : rest
        at = match(hay, p)
        if (at == 0) { out = out rest; break }
        len = RLENGTH
        if (len < 1) { out = out rest; break }
        out = out substr(rest, 1, at - 1) "\033[1;31m" substr(rest, at, len) "\033[0m"
        rest = substr(rest, at + len)
      }
      return out
    }
    NR >= first && NR <= last { print hl(substr($0, 1, w), pat) }
  ' "$view"
}
# Container inventory with live state: the spec gives name, image and type, the status
# gives readiness, restarts, current state and the last exit. Both are bounded reads and
# both are needed before an operator can decide which container to read logs from.
inspector_container_rows() { # ns pod spec-file status-file -> TYPE NAME READY RST STATE LAST-EXIT IMAGE
  local ns="$1" pod="$2" spec="$3" status="$4"
  "${KC[@]}" get pod "$pod" -n "$ns" -o 'jsonpath={range .spec.containers[*]}app{"\t"}{.name}{"\t"}{.image}{"\n"}{end}{range .spec.initContainers[*]}init{"\t"}{.name}{"\t"}{.image}{"\n"}{end}{range .spec.ephemeralContainers[*]}debug{"\t"}{.name}{"\t"}{.image}{"\n"}{end}' | inspector_clean > "$spec"
  "${KC[@]}" get pod "$pod" -n "$ns" -o 'jsonpath={range .status.containerStatuses[*]}{.name}{"\t"}{.ready}{"\t"}{.restartCount}{"\t"}{.state.waiting.reason}{"\t"}{.state.terminated.reason}{"\t"}{.state.running.startedAt}{"\t"}{.lastState.terminated.reason}{"\t"}{.lastState.terminated.exitCode}{"\n"}{end}{range .status.initContainerStatuses[*]}{.name}{"\t"}{.ready}{"\t"}{.restartCount}{"\t"}{.state.waiting.reason}{"\t"}{.state.terminated.reason}{"\t"}{.state.running.startedAt}{"\t"}{.lastState.terminated.reason}{"\t"}{.lastState.terminated.exitCode}{"\n"}{end}' | inspector_clean > "$status"
  awk -F '\t' -v sf="$status" '
    FILENAME == sf { nm = $1
      st = ($4 != "") ? $4 : (($5 != "") ? $5 : (($6 != "") ? "Running" : "unknown"))
      STATE[nm] = st; READY[nm] = $2; RST[nm] = $3
      LAST[nm] = ($7 != "") ? $7 (($8 != "" && $8 != "0") ? " exit=" $8 : "") : ""
      next }
    NF >= 3 { nm = $2
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", $1, nm,
        (READY[nm] == "" ? "?" : (READY[nm] == "true" ? "ready" : "not-ready")),
        (RST[nm] == "" ? "?" : RST[nm]),
        (STATE[nm] == "" ? "no status yet" : STATE[nm]),
        (LAST[nm] == "" ? "-" : LAST[nm]),
        ($3 == "" ? "-" : $3) }
  ' "$status" "$spec"
}

# Pick a container: name, type, readiness, restarts, state, last exit and image.
# Returns the chosen name in INSPECTOR_CONTAINER (plus INSPECTOR_PANE for l/p).
inspector_container_picker() { # ns pod dir
  local ns="$1" pod="$2" d="$3" rows first=0 chosen=0 i=0 n=0
  local name type ready rst state last image line=""
  local items=()
  INSPECTOR_CONTAINER=""; INSPECTOR_PANE=""
  inspector_size; rows=$((INSPECTOR_ROWS - 9)); [ "$rows" -ge 3 ] || rows=3
  inspector_container_rows "$ns" "$pod" "$d/rows.spec" "$d/rows.status" > "$d/rows" 2> "$d/rows.err" || true
  while IFS= read -r line; do [ -n "$line" ] && items+=("$line"); done < "$d/rows"
  n=${#items[@]}
  if [ "$n" = 0 ]; then
    printf '\033[H\033[2J No containers reported for %s/%s.\n %s\n\n Press any key to return.\033[?25h' "$ns" "$pod" "$(head -c 300 "$d/rows.err" 2>/dev/null)"
    IFS= read -rsn1 _ </dev/tty || true
    return 1
  fi
  for ((i = 0; i < n; i++)); do
    IFS=$'\t' read -r type name _ <<< "${items[$i]}"
    [ "$name" != "${KDASH_INSPECT_CONTAINER:-}" ] || chosen=$i
  done
  while :; do
    [ "$chosen" -ge "$first" ] || first=$chosen
    [ "$chosen" -lt "$((first + rows))" ] || first=$((chosen - rows + 1))
    printf '\033[H\033[2J Containers of %s/%s | Context: %s\n\n' "$ns" "$pod" "${CTX_NAME:-current}"
    printf ' %-3s %-26s %-8s %-6s %-5s %-5s %-16s %-14s %s\n' '#' NAME TYPE READY RST STATE 'LAST EXIT' IMAGE
    for ((i = first; i < n && i < first + rows; i++)); do
      IFS=$'\t' read -r type name ready rst state last image <<< "${items[$i]}"
      printf '%s%-3s %-26s %-8s %-6s %-5s %-5s %-16s %-14s %s\n' "$([ "$i" = "$chosen" ] && printf '>' || printf ' ')" "$((i + 1))" \
        "${name:0:26}" "${type:0:8}" "${ready}" "$rst" "${state:0:16}" "${last:0:14}" \
        "${image:0:$((INSPECTOR_COLS - 100 > 8 ? INSPECTOR_COLS - 100 : 8))}"
    done
    printf '\033[%s;1H j/k or arrows select | 1-9 open that container | Enter summary | l current logs | p previous logs | q/Esc cancel\033[J' "$((INSPECTOR_ROWS - 2))"
    printf '\033[%s;1H Every container of this pod, including init and debug containers. Init is shown first in the pod spec.\033[?25h' "$((INSPECTOR_ROWS - 1))"
    inspector_key || break
    case "$INSPECTOR_KEY" in
      q|$'\033') return 1 ;;
      j) chosen=$(((chosen + 1) % n)) ;;
      k) chosen=$(((chosen + n - 1) % n)) ;;
      g) chosen=0 ;; G) chosen=$((n - 1)) ;;
      [1-9]) i=$((INSPECTOR_KEY - 1))
             [ "$i" -lt "$n" ] || continue
             IFS=$'\t' read -r type name _ <<< "${items[$i]}"; INSPECTOR_CONTAINER="$name"; return 0 ;;
      l|p) IFS=$'\t' read -r type name _ <<< "${items[$chosen]}"
           INSPECTOR_CONTAINER="$name"
           [ "$INSPECTOR_KEY" = l ] && INSPECTOR_PANE=current || INSPECTOR_PANE=previous
           return 0 ;;
      ''|i|$'\n') IFS=$'\t' read -r type name _ <<< "${items[$chosen]}"; INSPECTOR_CONTAINER="$name"; return 0 ;;
    esac
  done
  return 1
}

inspector_safe_name() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_' ;;
    *) printf '%s' "$1" ;;
  esac
}

inspector_report_dir() { printf '%s' "${KDASH_REPORT_DIR:-${HOME:-/tmp}/kdash_reports}"; }

# Export exactly what is on screen (the filtered view) so it can go into a ticket.
# This is always explicit: the automatic report bundle still never contains logs.
inspector_export() { # view-file ns pod container pane [total-lines] [matching-lines] -> writes the file and prints its path
  local view="$1" ns="$2" pod="$3" cont="$4" pane="$5" tot="${6:-0}" hit="${7:-0}" dir="" file=""
  dir="$(inspector_report_dir)/inspector"
  (umask 077; mkdir -p "$dir") || return 1
  file="$dir/kdash_inspect_$(inspector_safe_name "$ns")_$(inspector_safe_name "$pod")_$(inspector_safe_name "${cont:-pod}")_$(inspector_safe_name "$pane")_$(date +%Y%m%d_%H%M%S).txt"
  {
    printf '# kdash inspector export\n'
    printf '# context: %s | namespace: %s | pod: %s | container: %s | pane: %s\n' "${CTX_NAME:-current}" "$ns" "$pod" "${cont:-(none)}" "$pane"
    printf '# generated: %s by %s on %s\n' "$(date -Is 2>/dev/null || date)" "${USER:-unknown}" "$(hostname 2>/dev/null || printf host)"
    printf '# search: %s | level: %s | lines exported: %s of %s | matching lines: %s\n' \
      "${INSPECTOR_SEARCH:-none}" "${INSPECTOR_LEVEL_NAME:-all}" "${INSPECTOR_VIEW_LINES:-0}" "$tot" "$hit"
    printf '# NOTE: describe output and logs can contain sensitive values (tokens, addresses,\n#       payloads). Review before sharing outside your team.\n\n'
    cat "$view"
  } > "$file" || return 1
  printf '%s' "$file"
}

inspector_help() {
  printf '\033[H\033[2J kdash inspector - keys (any key returns)\n\n'
  printf ' FIND                          PANES                       NAVIGATE\n'
  printf '  /  find in this pane         s  summary                  j k arrows  line\n'
  printf '  &  show only matches         d  describe                 space b     page\n'
  printf '  n N  next / previous match   e  events                   PgUp PgDn   page\n'
  printf '  L  log level: all, ERROR,    !  why (event hypotheses)    g G Home End  top/bottom\n'
  printf '     WARN, INFO, DEBUG         l  current logs             c  choose container\n'
  printf '  f  follow logs               p  previous logs            r  reload now\n'
  printf '  w  export what you see       q Esc  back                ?  this help\n\n'
  printf ' / keeps the context around every match and highlights it; & hides everything else.\n'
  printf ' A lowercase pattern ignores case: /error finds ERROR and error.\n'
  printf ' n and N wrap around and put the match at the top of the pane.\n'
  printf ' c lists every container with readiness, restarts, state and last exit: pick one\n'
  printf ' and l/p read that container. Search and level stay active across panes.\n'
  printf ' w writes the filtered pane to %s/inspector/ (review it before sharing).\n\n' "$(inspector_report_dir)"
  printf '\033[?25h any key returns'
  IFS= read -rsn1 _ </dev/tty || true
}

inspector_detail() { # nested UI; q returns to the picker, keeping the identity
  local ns="$1" pod="$2" d="$3" pane="${INSPECTOR_PANE:-summary}" loaded="" reload=1 viewdirty=1 rows_stale=1
  local body="$3/body" view="$3/view" matchf="$3/matches"
  local offset=0 count=0 total=0 matches=0 msg="" rows pid rc keep_offset=0 follow=0 atbottom=0
  local container="${KDASH_INSPECT_CONTAINER:-}" file="" target=0 idx=0 cline="" pinfo=""
  local INSPECTOR_REFRESH_EVENTS=0
  INSPECTOR_PANE=""
  inspector_limits          # tail/bytes/follow defaults must exist in this shell too
  while :; do
    inspector_size; rows=$((INSPECTOR_ROWS - 8))
    if [ "$loaded" != "$pane" ] || [ "$reload" = 1 ]; then
      printf '\033[H\033[2J Context: %s | Namespace: %s | Pod: %s\n\n Reading %s... (q/Esc cancels)\n' "${CTX_NAME:-current}" "$ns" "$pod" "$pane"
      # Keep navigation available during a slow read. KC supplies request-timeout.
      (
        trap 'for inspector_child in $(jobs -pr); do kill "$inspector_child" 2>/dev/null || true; done; exit 130' TERM INT
        if [ "$rows_stale" = 1 ]; then
          inspector_container_rows "$ns" "$pod" "$d/rows.spec" "$d/rows.status" > "$d/rows" 2> "$d/rows.err" || true
        fi
        if { [ "$pane" = events ] || [ "$pane" = explain ]; } && declare -F events_collect >/dev/null; then
          if [ ! -f "${TOOLKIT_DIR:-}/events.status" ] || [ "$INSPECTOR_REFRESH_EVENTS" = 1 ]; then events_collect; fi
        fi
        case "$pane" in
          summary) inspector_summary "$ns" "$pod" "$body" ;;
          describe) inspector_query "$body" describe pod "$pod" -n "$ns" ;;
          events) inspector_events "$ns" "$pod" "$body" ;;
          explain) inspector_explain "$ns" "$pod" "$body" ;;
          current|previous)
            if [ -z "$container" ]; then container="$(awk -F '\t' 'NF >= 2 {print $2; exit}' "$d/rows" 2>/dev/null)"; fi
            inspector_logs "$ns" "$pod" "$container" "$pane" "$body" ;;
        esac
      ) & pid=$!
      while kill -0 "$pid" 2>/dev/null; do
        INSPECTOR_KEY=""; IFS= read -rsn1 -t 0.1 INSPECTOR_KEY </dev/tty || true
        case "$INSPECTOR_KEY" in q|b|$'\033')
          kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
          return 0 ;;
        esac
      done
      wait "$pid" 2>/dev/null || true
      INSPECTOR_REFRESH_EVENTS=0; rows_stale=0; reload=0; loaded="$pane"; viewdirty=1
      [ "$pane" != summary ] || rows_stale=1      # the summary pane shows per-container state
      if [ -z "$container" ]; then container="$(awk -F '\t' 'NF >= 2 {print $2; exit}' "$d/rows" 2>/dev/null)"; fi
      [ "$keep_offset" = 1 ] || offset=0
      keep_offset=0
      declare -F audit >/dev/null && audit INSPECT "namespace=$ns pod=$pod pane=$pane container=${container:--} search=${INSPECTOR_SEARCH:-none} level=${INSPECTOR_LEVEL_NAME:-all}"
    fi
    if [ "$viewdirty" = 1 ]; then
      inspector_view_build "$body" "$view" "$matchf"
      viewdirty=0; count="$INSPECTOR_VIEW_LINES"; matches="$INSPECTOR_MATCHES"
      total="$(wc -l < "$body" 2>/dev/null || printf 0)"
      # A new search starts at its first match, which is what an operator expects.
      if [ -n "${INSPECTOR_SEARCH:-}" ] && [ "$matches" -gt 0 ]; then
        cur=1; offset=$(($(awk 'NR == 1 {print $1}' "$matchf") - 1)); msg="match 1/$matches"
      fi
    fi
    [ "$offset" -lt 0 ] && offset=0
    [ "$offset" -le "$((count > rows ? count - rows : 0))" ] || offset=$((count > rows ? count - rows : 0))
    cline=""
    cline="$(awk -F '\t' -v want="$container" '$2 == want { printf "%s | %s | restarts %s | %s | last exit %s | %s", $2, $3, $4, $5, $6, $7; exit }' "$d/rows" 2>/dev/null)"
    [ -n "$cline" ] || cline="${container:-(no container reported)}"
    pinfo="Pane: $pane | rows $((offset + 1))-$((offset + rows < count ? offset + rows : count))/$count"
    [ "$total" = "$count" ] || pinfo="$pinfo (of $total after filtering)"
    [ -z "${INSPECTOR_SEARCH:-}" ] || {
      if [ "${INSPECTOR_ONLY:-0}" = 1 ]; then pinfo="$pinfo | only /$INSPECTOR_SEARCH: $matches of $total lines"
      else pinfo="$pinfo | search /$INSPECTOR_SEARCH ($matches matching)"; fi; }
    case "${INSPECTOR_LEVEL_NAME:-all}" in all) ;; *) pinfo="$pinfo | level $INSPECTOR_LEVEL_NAME" ;; esac
    [ "$follow" = 1 ] && pinfo="$pinfo | follow ${INSPECTOR_FOLLOW_SECS:-5}s"
    printf '\033[H\033[2J Context: %s\n Namespace: %s | Pod: %s\n Container: %s\n %s\n\n' \
      "${CTX_NAME:-current}" "$ns" "$pod" "${cline:0:$INSPECTOR_COLS}" "${pinfo:0:$INSPECTOR_COLS}"
    inspector_show "$view" "$((offset + 1))" "$((offset + rows))" "$INSPECTOR_COLS" "${COLOR:-1}"
    printf '\033[%s;1H s summary | d describe | e events | ! why | l logs | p previous | c container | ? keys\033[J' "$((INSPECTOR_ROWS - 2))"
    printf '\033[%s;1H / find | & only matches | n N match | L level | f follow(%s) | w export | r reload | q back\033[K' \
      "$((INSPECTOR_ROWS - 1))" "$([ "$follow" = 1 ] && printf on || printf off)"
    if [ -n "$msg" ]; then
      printf '\033[%s;1H\033[1;33m %s\033[0m\033[K' "$INSPECTOR_ROWS" "${msg:0:$((INSPECTOR_COLS - 2))}"
    else
      printf '\033[%s;1H\033[K' "$INSPECTOR_ROWS"
    fi
    if [ "$follow" = 1 ] && { [ "$pane" = current ] || [ "$pane" = previous ]; }; then
      [ "$offset" -lt "$((count > rows ? count - rows : 0))" ] && atbottom=0 || atbottom=1
      if ! inspector_key "${INSPECTOR_FOLLOW_SECS:-5}"; then
        # No key inside the follow interval: refresh the log pane where the operator is.
        reload=1; keep_offset=1
        [ "$atbottom" = 0 ] || offset=999999
        msg=''
        continue
      fi
    elif inspector_key; then :; else return 0; fi
    msg=""
    case "$INSPECTOR_KEY" in
      q|$'\033') return 0 ;;
      s) pane=summary ;; d) pane=describe ;; e) pane=events ;; '!') pane=explain ;; l) pane=current ;; p) pane=previous ;;
      j) offset=$((offset + 1)) ;; k) offset=$((offset - 1)) ;; ' ') offset=$((offset + rows)) ;; b) offset=$((offset - rows)) ;;
      g) offset=0 ;; G) offset=999999 ;;
      '/') if inspector_search_prompt "$pane" find; then viewdirty=1; fi ;;
      '&') if inspector_search_prompt "$pane" only; then viewdirty=1; fi ;;
      n|N) if [ "$matches" -gt 0 ] && [ -s "$matchf" ]; then
             read -r target idx <<< "$(awk -v cur="$offset" -v back="$([ "$INSPECTOR_KEY" = N ] && printf 1 || printf 0)" '
               { L[NR] = $1 }
               END { if (NR == 0) { print "0 0"; exit }
                 if (!back) { for (k = 1; k <= NR; k++) if (L[k] > cur + 1) { print L[k], k; exit }
                              print L[1], 1; exit }
                 for (k = NR; k >= 1; k--) if (L[k] < cur + 1) { print L[k], k; exit }
                 print L[NR], NR }' "$matchf")"
             if [ "${target:-0}" -gt 0 ]; then offset=$((target - 1)); msg="match $idx/$matches"; fi
           else msg="no match for /${INSPECTOR_SEARCH:-} (press / to search)"; fi ;;
      L) inspector_level_cycle; viewdirty=1; offset=0; msg="log level: $INSPECTOR_LEVEL_NAME" ;;
      f) case "$pane" in
           current|previous) follow=$((1 - follow)); reload=1; keep_offset=1; viewdirty=1
             [ "$follow" = 1 ] && msg="follow every ${INSPECTOR_FOLLOW_SECS}s - press f to stop" || msg='follow off' ;;
           *) msg='follow applies to the log panes (l current, p previous)' ;;
         esac ;;
      w) if file="$(inspector_export "$view" "$ns" "$pod" "$container" "$pane" "$total" "$matches")"; then
           msg="exported $count line(s) to $file"
           declare -F audit >/dev/null && audit INSPECT_EXPORT "namespace=$ns pod=$pod container=${container:--} pane=$pane lines=$count search=${INSPECTOR_SEARCH:-none} level=${INSPECTOR_LEVEL_NAME:-all} file=$file"
         else msg='export failed: is the report directory writable?'; fi ;;
      '?') inspector_help ;;
      r) if [ "$pane" = events ] || [ "$pane" = explain ]; then
           # Collection runs in the same cancellable worker on the next pass.
           rm -f -- "$d/events-refreshed"; INSPECTOR_REFRESH_EVENTS=1
         fi
         rows_stale=1; reload=1; keep_offset=1; msg='reloading' ;;
      c) if inspector_container_picker "$ns" "$pod" "$d"; then
           container="$INSPECTOR_CONTAINER"; KDASH_INSPECT_CONTAINER="$container"
           if [ -n "${INSPECTOR_PANE:-}" ]; then pane="$INSPECTOR_PANE"; INSPECTOR_PANE=""; fi
           rows_stale=1; reload=1; viewdirty=1; msg="container: $container"
           declare -F audit >/dev/null && audit INSPECT_CONTAINER "namespace=$ns pod=$pod container=$container pane=$pane"
         else msg='container selection cancelled'; fi ;;
    esac
  done
}

inspector_open() { # optional explicit ns/pod; otherwise a persistent pod picker
  local d="${TMPD:?}/inspector/live" chosen=0 first=0 rows i n line ns pod status ready restarts node
  local items=() picked="${POD_PICK:-}"
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    [ -n "${2:-}" ] && { inspector_render "$1" "$2"; return $?; }
    printf 'kdash: the pod picker requires a terminal; use --inspect POD for text output.\n' >&2; return 2
  fi
  (umask 077; mkdir -p "$d") || return 1
  if [ -n "${2:-}" ]; then
    inspector_identity_ok "$1" "$2" || return 2
    POD_PICK="$1/$2"; inspector_detail "$1" "$2" "$d"
    rm -rf -- "$d"; return 0
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    items+=("$line")
    IFS=$'\t' read -r ns pod _ <<< "$line"
    [ "$ns/$pod" != "$picked" ] || chosen=$((${#items[@]} - 1))
  done < <(inspector_model_rows)
  n=${#items[@]}
  while :; do
    inspector_size; rows=$((INSPECTOR_ROWS - 8))
    [ "$chosen" -ge "$first" ] || first=$chosen
    [ "$chosen" -lt "$((first + rows))" ] || first=$((chosen - rows + 1))
    printf '\033[H\033[2J Select pod | Context: %s\n Namespace: %s | %s matching pods\n Selected identity: %s\n\n' "${CTX_NAME:-current}" "${NS:-default}" "$n" "${POD_PICK:-(none)}"
    if [ "$n" = 0 ]; then printf ' No pods match. F edits structured filters; q returns.\n'; fi
    for ((i=first; i<n && i<first+rows; i++)); do
      IFS=$'\t' read -r ns pod status ready restarts node <<< "${items[$i]}"
      line="$(printf '%s %s/%s  %s  ready=%s  restarts=%s  node=%s' "$([ "$i" = "$chosen" ] && printf '>' || printf ' ')" "$ns" "$pod" "$status" "$ready" "$restarts" "$node")"
      printf '%s\n' "${line:0:$INSPECTOR_COLS}"
    done
    printf '\033[%s;1H j/k or arrows select | Enter/i inspect | c containers | F filters | q/Esc dashboard\n Logs are fetched only when you open l/p; search and follow stay inside the pod.\033[J' "$((INSPECTOR_ROWS - 1))"
    inspector_key || break
    case "$INSPECTOR_KEY" in
      q|$'\033') break ;;
      j) [ "$n" = 0 ] || chosen=$(((chosen + 1) % n)) ;;
      k) [ "$n" = 0 ] || chosen=$(((chosen + n - 1) % n)) ;;
      ''|i) if [ "$n" -gt 0 ]; then
        IFS=$'\t' read -r ns pod _ <<< "${items[$chosen]}"; POD_PICK="$ns/$pod"
        inspector_detail "$ns" "$pod" "$d"
      fi ;;
      c) if [ "$n" -gt 0 ]; then
        # Go straight into one container of the highlighted pod.
        IFS=$'\t' read -r ns pod _ <<< "${items[$chosen]}"; POD_PICK="$ns/$pod"
        if inspector_container_picker "$ns" "$pod" "$d"; then
          KDASH_INSPECT_CONTAINER="$INSPECTOR_CONTAINER"
          inspector_detail "$ns" "$pod" "$d"
          KDASH_INSPECT_CONTAINER=""; INSPECTOR_PANE=""
        fi
      fi ;;
      F) inspector_filter_prompt; break ;;
    esac
  done
  rm -rf -- "$d"
  printf '\033[2J'
  return 0
}

inspector_filter_apply() { # semicolon separated fields, atomically assigned
  local value="$1" pair key val regex_rc
  local label="${KDASH_LABEL_SELECTOR:-}" status="${KDASH_STATUS_FILTER:-}" node="${KDASH_NODE_FILTER:-}"
  local workload="${KDASH_WORKLOAD_FILTER:-}" unhealthy="${KDASH_UNHEALTHY:-0}" fields=()
  if [ "$value" = clear ]; then
    KDASH_LABEL_SELECTOR=""; KDASH_STATUS_FILTER=""; KDASH_NODE_FILTER=""; KDASH_WORKLOAD_FILTER=""; KDASH_UNHEALTHY=0
    return 0
  fi
  IFS=';' read -r -a fields <<< "$value"
  for pair in "${fields[@]}"; do
    pair="${pair#"${pair%%[![:space:]]*}"}"; pair="${pair%"${pair##*[![:space:]]}"}"
    [ -n "$pair" ] || continue
    case "$pair" in *=*) ;; *) printf 'Each filter must be key=value.\n' >&2; return 2 ;; esac
    key="${pair%%=*}"; val="${pair#*=}"
    [[ "$val" != *[$'\001'-$'\037'$'\177']* ]] || { printf 'Control bytes are not allowed in filters.\n' >&2; return 2; }
    [ "${#val}" -le 1024 ] || { printf 'Filter values must be at most 1024 characters.\n' >&2; return 2; }
    case "$key" in
      label) label="$val" ;; status) status="$val" ;; node) node="$val" ;; workload) workload="$val" ;;
      unhealthy) case "$val" in 1|true|yes) unhealthy=1 ;; 0|false|no|'') unhealthy=0 ;; *) printf 'unhealthy must be 0 or 1.\n' >&2; return 2 ;; esac ;;
      *) printf 'Unknown filter %s. Use label, status, node, workload, unhealthy.\n' "$key" >&2; return 2 ;;
    esac
  done
  for val in "$status" "$workload"; do
    if printf '' | grep -E -- "$val" >/dev/null 2>&1; then :
    else
      regex_rc=$?
      [ "$regex_rc" = 1 ] || { printf 'Status and workload must be valid extended regular expressions.\n' >&2; return 2; }
    fi
  done
  KDASH_LABEL_SELECTOR="$label"; KDASH_STATUS_FILTER="$status"; KDASH_NODE_FILTER="$node"
  KDASH_WORKLOAD_FILTER="$workload"; KDASH_UNHEALTHY="$unhealthy"
  return 0
}

inspector_filter_prompt() {
  local line="" msg=""
  while :; do
    printf '\033[H\033[2J Structured pod filters | Context: %s | Namespace: %s\n\n' "${CTX_NAME:-current}" "${NS:-default}"
    printf ' label=%s\n status=%s\n node=%s\n workload=%s\n unhealthy=%s\n\n' \
      "${KDASH_LABEL_SELECTOR:-}" "${KDASH_STATUS_FILTER:-}" "${KDASH_NODE_FILTER:-}" "${KDASH_WORKLOAD_FILTER:-}" "${KDASH_UNHEALTHY:-0}"
    printf ' Enter semicolon-separated fields; omitted fields stay unchanged.\n Example: label=app in (api,worker);status=Pending|CrashLoop;unhealthy=1\n Node uses an exact match; status and workload use extended regex.\n Empty value clears a field. Type clear to reset all; Enter cancels.\n%s\n\033[?25h filters > ' "$msg"
    IFS= read -r line </dev/tty || { printf '\033[?25l'; return 1; }
    printf '\033[?25l'
    [ -n "$line" ] || return 1
    if msg="$(inspector_filter_apply "$line" 2>&1)"; then
      # Apply in this shell too: command substitution above isolated assignments.
      inspector_filter_apply "$line" || return 2
      declare -F audit >/dev/null && audit FILTER_STRUCTURED "label=$KDASH_LABEL_SELECTOR status=$KDASH_STATUS_FILTER node=$KDASH_NODE_FILTER workload=$KDASH_WORKLOAD_FILTER unhealthy=$KDASH_UNHEALTHY"
      return 0
    fi
  done
}

inspector_palette() {
  local command=""
  printf '\033[H\033[2J Command palette | Context: %s | Namespace: %s\n\n' "${CTX_NAME:-current}" "${NS:-default}"
  printf ' inspect                 Choose a pod and inspect it\n filter                  Structured pod filters\n pods / nodes / workloads / ip / mem / io / alerts\n services / storage / events / explain / doctor\n help                    Dashboard help\n\n Commands use fixed handlers and never execute shell text.\n\033[?25h : '
  IFS= read -r command </dev/tty || { printf '\033[?25l'; return 1; }; printf '\033[?25l'
  case "$command" in
    '') return 0 ;; inspect|i) inspector_open ;; filter|F) inspector_filter_prompt ;;
    pods|nodes|workloads|ip|mem|io|alerts) VIEW="$command"; SCROLL=0; HSCROLL=0 ;;
    services|storage|events|explain|doctor) VIEW="$command"; TOOLKIT_REQUESTED=1; SCROLL=0; HSCROLL=0 ;;
    help|'?') if declare -F show_help >/dev/null; then show_help; else printf '\n Use ? on the dashboard for help.\n'; fi ;;
    *) declare -F flash >/dev/null && flash "Unknown command: ${command:0:70}" 5; return 2 ;;
  esac
}

# END KDASH MODULES
#-- main ------------------------------------------------------------------------
toolkit_init
if [ "$DO_DOCTOR" = 1 ]; then doctor_run; exit $?; fi
if [ "$DO_EVENTS" = 1 ] || [ "$DO_EXPLAIN" = 1 ]; then
    events_collect
    if [ "$DO_EVENTS" = 1 ]; then events_render; else explain_render "${NS/\(all namespaces\)/}" "$EXPLAIN_POD"; fi
    [ "$(cat "$TOOLKIT_DIR/events.status" 2>/dev/null)" = ok ]; exit $?
fi
if [ -n "$INSPECT_POD" ]; then
    [ "$ALL_NS" = 0 ] || die "--inspect requires an explicit namespace"
    events_collect; inspector_render "$NS" "$INSPECT_POD"; exit $?
fi
case "$VIEW" in services|storage|events|explain)
    if [ "$ONCE" = 1 ]; then
        events_collect; health_collect
        case "$VIEW" in services) health_render_services ;; storage) health_render_storage ;; events) events_render ;; explain) explain_render ;; esac
        exit 0
    fi ;;
esac
[ "$DO_SREP" = 1 ] && { session_report_main "$SREP_ARG"; exit 0; }
if [ "$PICK_NS" = 1 ]; then
  [ "$ALTSCR" = 1 ] && printf '\033[?1049h'
  # a pick is only taken when its pods can be read; otherwise back to the list with the reason
  picked_ok=0
  while ns_pick start; do
    if [ "$PICKED" = "*" ]; then sc=(--all-namespaces); else sc=(-n "$PICKED"); fi
    printf '\033[H\033[2J opening %s ...\n' "${PICKED/#\*/all namespaces}"
    if "${KC[@]}" get pods "${sc[@]}" --request-timeout=20s -o name > /dev/null 2> "$TMPD/pick.err"; then picked_ok=1; audit NS_PICK "namespace=${PICKED/#\*/all-namespaces}"; break; fi
    audit NS_PICK_DENIED "namespace=${PICKED/#\*/all-namespaces} reason=$(sed -n '1{s/^Error from server ([A-Za-z]*): //;p}' "$TMPD/pick.err" | cut -c1-140)"
    [ "$PICKED" != "*" ] && NSACC["$PICKED"]=no
    PICK_MSG="cannot open ${PICKED/#\*/all namespaces}: $(sed -n '1{s/^Error from server ([A-Za-z]*): //;p}' "$TMPD/pick.err" | cut -c1-140)"
  done
  if [ "$picked_ok" = 1 ]; then
    if [ "$PICKED" = "*" ]; then ALL_NS=1; NS="(all namespaces)"; SCOPE=(--all-namespaces)
    else NS="$PICKED"; SCOPE=(-n "$NS"); fi
    NS_FALLBACK=0
  elif [ -z "$NS" ]; then NS="default"; SCOPE=(-n "$NS"); NS_FALLBACK=1; fi
  [ "$ALTSCR" = 1 ] && printf '\033[?1049l'
  printf '\033[?25h'
fi
if [ "$INTERACTIVE" = 1 ]; then fetch; else refresh_spec; refresh_top; fi
[ "$INTERACTIVE" = 1 ] || [ -s "$SPEC" ] || [ "$SPEC_OK" = 1 ] || {
  [ -s "$TMPD/spec.err" ] && sed 's/^/kdash: /' "$TMPD/spec.err" >&2
  fail "could not read pods (context ${CTX_NAME}, namespace ${NS}). Check access and kubeconfig."
}
# only namespaces that could be opened go to the recent list
[ "$INTERACTIVE" = 1 ] && [ "$ALL_NS" = 0 ] && [ "${NS_FALLBACK:-0}" = 0 ] && remember_ns "$NS"
build_model || fail "could not build the data model (awk failed)"
if [ "$ONCE" = 1 ] || [ "$DO_SNAP" = 1 ] || [ "$DO_REPORT" = 1 ]; then
  [ "$IO_WAIT" -gt 0 ] && { io_wait_once; build_model; }
else
  [ "$INTERACTIVE" = 1 ] || io_tick  # live: detect the IO source and take the first sample
fi
NPODS=$(awk -F'\t' '$1=="pods"{print $2}' "$MODEL/meta.tsv")

if [ "$DO_SNAP" = 1 ]; then
  case "$SNAP_SEL" in
    ""|report|ns|n)
      # one HTML with every tab; history from a kdash session on this
      # context / namespace that is still recording (sampled in the last 15 min)
      _sp="$REPORT_DIR/sessions/kdash_$(safe_name "$CTX_NAME")_$(safe_name "$NS")_"
      _sd="$(ls -1dt "$_sp"* 2>/dev/null | head -1)"
      if [ -n "$_sd" ] && [ -f "$_sd/ns.tsv" ] && [ $(( $(date +%s) - $(awk -F'\t' '{ l = $1 } END { print l + 0 }' "$_sd/ns.tsv") )) -le 900 ]; then :; else _sd=""; fi
      printf 'kdash namespace report  (%s / %s)%s
' "$CTX_NAME" "$NS" "${_sd:+  history from running session ${_sd##*/}}"
      namespace_report "$_sd" | sed 's/^/  /'; rc=${PIPESTATUS[0]} ;;
    *)
      printf 'kdash HTML snapshots  (%s / %s)\n' "$CTX_NAME" "$NS"
      take_snapshots "$SNAP_SEL" | sed 's/^/  /'; rc=${PIPESTATUS[0]} ;;
  esac
  [ "$rc" = 0 ] && printf '  index   %s/index.html\n' "$REPORT_DIR"
  [ "$rc" = 0 ] || exit "$rc"
  [ "${NPODS:-0}" -gt 0 ] || exit 3
  exit 0
fi
if [ "$DO_REPORT" = 1 ]; then
  make_report || fail "report generation failed"
  [ "${NPODS:-0}" -gt 0 ] || exit 3
  exit 0
fi

if [ "$ONCE" = 1 ]; then
  if [ "$OUTFMT" != text ]; then
    emit_tables "$OUTFMT" "$VIEW"
  elif [ "$VIEW" = all ]; then
    first=1
    for v in pods nodes workloads ip mem io alerts; do
      [ "$first" = 1 ] || printf '\n'; first=0
      render_text_view "$v"
    done
  else
    render_text_view "$VIEW"
  fi
  [ "${NPODS:-0}" -gt 0 ] || exit 3
  exit 0
fi
[ "$VIEW" = all ] && VIEW=pods
session_start && session_tick
if [ ! -t 0 ] || [ ! -t 1 ]; then          # piped: plain frames, no keys
  # stop when the reader goes away (kdash | head, closed pager)
  while :; do render; cat "$HDRF" "$BODYF" "$FTRF" 2>/dev/null || exit 0; sleep "$INTERVAL"; fetch; done
fi

if ! render; then
  printf 'kdash: could not render a frame (see errors above)\n' >&2
  exit 1
fi
if [ "${NPODS:-0}" -eq 0 ] && [ "$INTERACTIVE" = 0 ]; then
  printf 'kdash: no pods matched "%s" in namespace %s (context %s)\n' "$FILTER" "$NS" "$CTX_NAME" >&2
  exit 3
fi
[ "${NPODS:-0}" -eq 0 ] && flash "no pods match \"$FILTER\" in $NS - n picks another namespace, / changes the filter" 15

LOOPED=1
ALERT_STATE="$TMPD/alerts.state"; : > "$ALERT_STATE"
[ -n "$FLASH" ] || { flash "AUDITED session $AUDIT_SID - every action is logged; use is your responsibility (kdash --about)" 10; FLASH_BG="45;97"; }
while IFS= read -rsn1 -t 0.01 _flush; do :; done
exec 3>&2 2>"$ERRLOG"
[ "$ALTSCR" = 1 ] && printf '\033[?1049h'
printf '\033[?25l\033[2J'
LAST=$(date +%s); check_alerts
case "$VIEW" in services|storage|events|explain|doctor) TOOLKIT_REQUESTED=1 ;; esac
while :; do
  now=$(date +%s)
  if [ "$PAUSED" = 0 ] && [ $((now - LAST)) -ge "${INTERVAL%.*}" ]; then fetch; LAST=$now; check_alerts; fi
  fetch_adopt; toolkit_filters_changed; toolkit_tick
  render; paint
  if [ "${BASH_VERSINFO[0]:-3}" -lt 4 ]; then sleep "$INTERVAL"; continue; fi
  if IFS= read -rsn1 -t 0.4 key; then [ -n "$key" ] || key=$'\n'; else key=""; fi
  out=""; AK_NS="$NS"
  case "$key" in
    1) VIEW=pods; SCROLL=0; HSCROLL=0 ;; 2) VIEW=nodes; SCROLL=0; HSCROLL=0 ;; 3) VIEW=workloads; SCROLL=0; HSCROLL=0 ;;
    4) VIEW=ip; SCROLL=0; HSCROLL=0 ;; 5) VIEW=mem; SCROLL=0; HSCROLL=0 ;; 6) VIEW=io; SCROLL=0; HSCROLL=0 ;;
    7) VIEW=alerts; SCROLL=0; HSCROLL=0 ;;
    8) VIEW=services; TOOLKIT_REQUESTED=1; SCROLL=0; HSCROLL=0 ;;
    9) VIEW=storage; TOOLKIT_REQUESTED=1; SCROLL=0; HSCROLL=0 ;;
    E) VIEW=events; TOOLKIT_REQUESTED=1; SCROLL=0; HSCROLL=0 ;;
    '!') VIEW=explain; TOOLKIT_REQUESTED=1; SCROLL=0; HSCROLL=0 ;;
    i|$'\n') inspector_open; printf '\033[2J' ;;
    ':') inspector_palette; printf '\033[2J' ;;
    F) inspector_filter_prompt; SPEC_AT=0; FETCH_NEXT=0; toolkit_cancel; build_model; LAST=0; printf '\033[2J' ;;
    $'\t'|v) next_view; SCROLL=0; HSCROLL=0 ;;
    j) SCROLL=$((SCROLL+1)) ;;
    k) SCROLL=$((SCROLL-1)) ;;
    ' '|f) SCROLL=$((SCROLL+10)) ;;
    b) SCROLL=$((SCROLL-10)) ;;
    g) SCROLL=0 ;;
    G) SCROLL=999999 ;;
    h) HSCROLL=$((HSCROLL-20)) ;;
    l) HSCROLL=$((HSCROLL+20)) ;;
    0) HSCROLL=0 ;;
    p) PODS_ONLY=$((1-PODS_ONLY)); SCROLL=0 ;;
    d) DETAIL=$((1-DETAIL)); SCROLL=0 ;;
    s) cycle_sort; SCROLL=0; flash "sort: $SORT ($([ "$SORT_REV" = 1 ] && echo 'reversed' || echo 'highest first / A-Z')) - o reverses" 4 ;;
    o) SORT_REV=$((1 - SORT_REV)); SCROLL=0; flash "sort order: $([ "$SORT_REV" = 1 ] && echo 'lowest first / Z-A' || echo 'highest first / A-Z')" 4 ;;
    w) GROUP=$((1 - GROUP)); SCROLL=0; flash "PODS: $([ "$GROUP" = 1 ] && echo 'grouped by workload' || echo 'flat list')" 4 ;;
    r) SPEC_AT=0; LAST=0 ;;
    x) flash "writing namespace report (all tabs + history) ..." 30; paint
       if out="$(namespace_report "$SDIR" 2>&1)"; then flash "report: $(printf '%s\n' "$out" | tail -1)" 12
       else flash "report failed: $(printf '%s' "$out" | tail -1)" 8; fi ;;
    e) printf '\033[%d;1H\033[K\033[?25h\033[7m HTML: Enter = one file, all tabs + history | c current view (%s) | 1-6 views (e.g. 256) | a all 6 separate | b full bundle > \033[0m' \
         "${KDASH_LINES:-$(tput lines 2>/dev/null || echo 40)}" "$VIEW"
       IFS= read -r sel </dev/tty || sel=""
       printf '\033[?25l'
       sel="$(printf '%s' "$sel" | tr -d ' ')"
       if [ -z "$sel" ] || [ "$sel" = n ]; then
         flash "writing namespace report (all tabs + history) ..." 30; paint
         if out="$(namespace_report "$SDIR" 2>&1)"; then flash "report: $(printf '%s\n' "$out" | tail -1)" 12
         else flash "report failed: $(printf '%s' "$out" | tail -1)" 8; fi
       elif [ "$sel" = b ]; then
         flash "writing full report bundle ..." 30; paint
         if out="$(make_report 2>&1)"; then flash "bundle: ${REPORT_HTML:-$(printf '%s\n' "$out" | sed -n 's/^  html *//p')}" 10
         else flash "export failed: $(printf '%s' "$out" | tail -1)" 8; fi
       else
         flash "writing HTML snapshot(s) ..." 60; paint
         if out="$(take_snapshots "$sel" 2>&1)"; then
           n=$(printf '%s\n' "$out" | grep -c '\.html$')
           if [ "$n" -gt 1 ]; then flash "$n HTML snapshots in $REPORT_DIR (index.html lists them)" 10
           else flash "snapshot: $(printf '%s\n' "$out" | tail -1)" 10; fi
         else flash "snapshot failed: $(printf '%s' "$out" | tail -1)" 8; fi
       fi ;;
    /) printf '\033[%d;1H\033[K\033[?25h filter (pod regex, empty = all): ' "${KDASH_LINES:-$(tput lines 2>/dev/null || echo 40)}"
       IFS= read -r nf </dev/tty || nf=""
       printf '\033[?25l'
       [ -n "$nf" ] || nf='.*'
       printf '' | grep -E -- "$nf" >/dev/null 2>&1; rc=$?
       if [ "$rc" -le 1 ]; then FILTER="$nf"; : > "$HIST"; : > "$NHIST"; rm -f "$TMPD/forecast.tsv"; build_model; session_reset_state; NPODS=1; SCROLL=0; flash "filter: $FILTER" 3
       else flash "invalid regex: $nf" 4; fi ;;
    n) while ns_pick live; do
         flash "opening namespace ${PICKED/#\*/all namespaces} ..." 30; printf '\033[2J'; paint
         if switch_ns "$PICKED"; then SCROLL=0; HSCROLL=0; flash "namespace $NS - ${NPODS:-0} pods (history restarted for this namespace)" 8; break; fi
         [ "$PICKED" != "*" ] && NSACC["$PICKED"]=no
         PICK_MSG="cannot open ${PICKED/#\*/all namespaces}: $SWITCH_ERR - still on $NS"
       done
       PICK_MSG=""; printf '\033[2J' ;;
    a) ALL_NODES=$((1 - ALL_NODES)); SCROLL=0
       flash "NODE POOLS: $([ "$ALL_NODES" = 1 ] && echo 'every node' || echo 'only nodes running this namespace')" 4 ;;
    P) if [ "$PAUSED" = 1 ]; then PAUSED=0; LAST=0; flash "live again - refreshing every ${INTERVAL}s" 4
       else PAUSED=1; PAUSED_AT=$(date +%s); flash "paused - data frozen at $(date +%H:%M:%S); P resumes (views, sort, scroll and reports still work)" 6; fi ;;
    +|=) set_interval up; flash "poll every ${INTERVAL}s" 3 ;;
    -|_) set_interval down; flash "poll every ${INTERVAL}s" 3 ;;
    Z) ZOOM=$((1 - ZOOM)); flash "NODE POOLS bars: $([ "$ZOOM" = 1 ] && echo 'auto zoom (small shares magnified, % values true)' || echo 'true scale')" 5 ;;
    c) POD_GRAPHS=$(( 1 - ${POD_GRAPHS:-1} )); flash "PODS graphs $([ "$POD_GRAPHS" = 1 ] && echo on || echo off) (c toggles)" 3 ;;
    z) cycle_window; [ "${SESSION_ON:-0}" = 1 ] && heat_build "$SDIR" "$TMPD/heat.tsv" "$WIN_S"; flash "chart window: $( [ "$TWIN" = all ] && echo 'all since kdash started' || echo "last $TWIN" )" 4 ;;
    T) cycle_theme; printf '\033[2J'; flash "colour theme: $THEME" 4 ;;
    '?') show_help ;;
    q) audit QUIT "key q"; cleanup; exit 0 ;;
    $'\033') IFS= read -rsn2 -t 0.05 seq || seq=""
             case "$seq" in '[A') SCROLL=$((SCROLL-1)) ;; '[B') SCROLL=$((SCROLL+1)) ;;
                            '[C') HSCROLL=$((HSCROLL+20)) ;; '[D') HSCROLL=$((HSCROLL-20)) ;;
                            '[5') SCROLL=$((SCROLL-10)) ;; '[6') SCROLL=$((SCROLL+10)) ;; esac ;;
  esac
  [ -n "$key" ] && audit_key "$key"
done
