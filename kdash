      hb(nv(f[10])), hb(nv(f[11])), fpct(pct(nst, tot), 6), C("90", VB), cbar(nst, tot - (nst > 0 ? nst : 0), tot, 24, "used") > bodyf }
  if (nio == 0) print C("90", "  no node-level series") > bodyf

