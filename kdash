  else rp = ""
  printf "%s %s %9s %s %s %s%s\n", lbl, C("90", kind), capx, C("90", VB),
    gbar((nu > 0 ? nu * ZF : nu), (nr > 0 ? nr * ZF : nr), cap, GW, "32"), p2(pct(nu, cap), pct(nr, cap)), rp > out
}
