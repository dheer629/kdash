      -v author="$KDASH_AUTHOR" -v asid="$AUDIT_SID" -v auser="$AUDIT_USER@$AUDIT_HOST" -v nowe="$NOW_S" -v tzoff="$TZ_OFF" -v tzname="$TZ_NAME" -v fcf="$fcf" -v fcwin="$FC_WIN" \
